#!/usr/bin/env python3
import socket
import sys
from pathlib import Path
from subprocess import run
from typing import TypedDict

try:
    import yaml

    HAS_YAML = True
except ImportError:
    HAS_YAML = False

SESSIONS_PATH = Path("~/.config/tmux/sessions.yml").expanduser()
SESSION_KEYS = [
    "M-!",
    "M-@",
    "M-#",
    "M-$",
    "M-%",
    "M-^",
    "M-&",
    "M-*",
    "M-(",
    "M-)",
]


class WindowSpec(TypedDict):
    window_name: str
    cwd: str


class SessionSpec(TypedDict):
    name: str
    windows: list[WindowSpec]


Spec = list[SessionSpec]


def renumber_sessions() -> None:
    """Make sure that numeric sessions names appear in linear order."""
    session_names = run(
        ["tmux", "list-sessions", "-F", "#S"], capture_output=True, text=True
    ).stdout.splitlines()
    numeric_sessions = [int(name) for name in session_names if name.isdigit()]
    for new_name, old_name in enumerate(numeric_sessions, 1):
        run(["tmux", "rename", "-t", str(old_name), str(new_name)])


def recreate_session(spec: SessionSpec) -> None:
    windows_to_create = spec["windows"]
    if not windows_to_create:
        return

    result = run(
        [
            "tmux",
            "list-windows",
            "-t",
            "=" + spec["name"] + ":",
            "-F",
            "#{window_name}",
        ],
        capture_output=True,
        text=True,
    )

    existing_windows: list[str] = []
    if result.returncode == 0:
        existing_windows = result.stdout.splitlines()

    if existing_windows:
        last_created_window = "=" + spec["name"] + ":" + existing_windows[-1]
    else:
        first_window = windows_to_create.pop(0)
        last_created_window = (
            "=" + spec["name"] + ":" + first_window["window_name"]
        )
        run(
            [
                "tmux",
                "new-session",
                "-d",
                "-s",
                spec["name"],
                "-n",
                first_window["window_name"],
                "-c",
                Path(first_window["cwd"]).expanduser(),
            ]
        )

    for window in windows_to_create:
        if window["window_name"] not in existing_windows:
            run(
                [
                    "tmux",
                    "new-window",
                    "-d",
                    "-a",
                    "-t",
                    last_created_window,
                    "-n",
                    window["window_name"],
                    "-c",
                    Path(window["cwd"]).expanduser(),
                ]
            )
        last_created_window = "=" + spec["name"] + ":" + window["window_name"]


def number_sessions(specs: Spec) -> None:
    """Number and chain sessions in file order, bind alt+shift+digit to each."""
    for num, (spec, key) in enumerate(zip(specs, SESSION_KEYS), 1):
        target = "=" + spec["name"] + ":"
        run(["tmux", "set", "-t", target, "@session-num", str(num)])
        run(["tmux", "bind", "-n", key, "switch-client", "-t", target])

    names = [spec["name"] for spec in specs]
    full, current, width = session_bar(names)
    run(["tmux", "set", "-g", "@session-bar", full])
    run(["tmux", "set", "-g", "@session-bar-current", current])
    run(["tmux", "set", "-g", "@session-bar-width", str(width)])
    for i, name in enumerate(names):
        target = "=" + name + ":"
        run(
            [
                "tmux",
                "set",
                "-t",
                target,
                "@session-next",
                names[(i + 1) % len(names)],
            ]
        )
        run(["tmux", "set", "-t", target, "@session-prev", names[i - 1]])


def escape_format(text: str) -> str:
    """Make text literal inside a tmux format."""
    return text.replace("#", "##").replace(",", "#,").replace("}", "#}")


def session_bar(names: list[str]) -> tuple[str, str, int]:
    """A status format listing the sessions in file order, current one lit.

    Built here rather than with tmux's own session loop, which goes in the
    order the sessions were created in, so a recreated one would land last.
    Also returns a format with only the current session, for when the full
    list doesn't fit, and the full list's width.
    """
    entries = []
    current_entries = []
    width = 0
    for num, name in enumerate(names, 1):
        session_id = run(
            ["tmux", "display", "-p", "-t", "=" + name + ":", "#{session_id}"],
            capture_output=True,
            text=True,
        ).stdout.strip()
        label = f" {num}:{escape_format(name)} "
        width += len(f" {num}:{name} ")
        is_current = f"#{{==:#{{session_name}},{escape_format(name)}}}"
        lit = (
            f"#[range=session|{session_id} #{{@session-current-style}}]"
            f"{label}#[norange default]"
        )
        entries.append(
            f"#{{?{is_current},{lit},"
            f"#[range=session|{session_id}]{label}#[norange]}}"
        )
        current_entries.append(f"#{{?{is_current},{lit},}}")
    return "".join(entries), "".join(current_entries), width


def load_specs() -> Spec | None:
    if not HAS_YAML:
        print("pyyaml module not installed", file=sys.stderr)
        return None

    if not SESSIONS_PATH.exists():
        print("sessions file does not exist", file=sys.stderr)
        return None

    config = yaml.safe_load(SESSIONS_PATH.read_text())
    specs: Spec = config.get(socket.gethostname(), [])
    return specs


def recreate_sessions() -> None:
    """Recreate sessions that should be persisted across machines."""
    specs = load_specs()
    if specs is None:
        return

    for spec in specs:
        recreate_session(spec)
    number_sessions(specs)


def move_session(delta: int) -> None:
    """Move the current session one place in this machine's part of the
    sessions file, wrapping around at either end like prefix Left/Right do
    for windows.

    The file is edited as text, so its comments and blank lines survive.
    """
    current = run(
        ["tmux", "display", "-p", "#S"], capture_output=True, text=True
    ).stdout.strip()
    lines = SESSIONS_PATH.read_text().splitlines(keepends=True)

    header = socket.gethostname() + ":"
    try:
        start = next(
            i for i, line in enumerate(lines) if line.rstrip() == header
        )
    except StopIteration:
        run(["tmux", "display", f"no {header} section in {SESSIONS_PATH}"])
        return
    end = next(
        (
            i
            for i in range(start + 1, len(lines))
            if lines[i].strip() and not lines[i][0].isspace()
        ),
        len(lines),
    )

    # each entry runs from its "- name:" line to the next one; blank lines
    # trailing it stay in their slot, so the spacing doesn't move along
    firsts = [
        i
        for i in range(start + 1, end)
        if lines[i].lstrip().startswith("- name:")
    ]
    if not firsts:
        return
    bodies: list[list[str]] = []
    gaps: list[list[str]] = []
    for first, after in zip(firsts, [*firsts[1:], end]):
        chunk = lines[first:after]
        cut = len(chunk)
        while cut > 1 and not chunk[cut - 1].strip():
            cut -= 1
        bodies.append(chunk[:cut])
        gaps.append(chunk[cut:])

    names = [body[0].split(":", 1)[1].strip().strip("'\"") for body in bodies]
    if current not in names:
        run(["tmux", "display", f"{current} is not in {SESSIONS_PATH}"])
        return

    i = names.index(current)
    body = bodies.pop(i)
    if delta < 0 and i == 0:
        bodies.append(body)
    elif delta > 0 and i == len(names) - 1:
        bodies.insert(0, body)
    else:
        bodies.insert(i + delta, body)

    entries = [line for body, gap in zip(bodies, gaps) for line in body + gap]
    lines[firsts[0] : end] = entries
    SESSIONS_PATH.write_text("".join(lines))
    recreate_sessions()


def main() -> None:
    if sys.argv[1:2] == ["move"]:
        move_session(int(sys.argv[2]))
        return
    renumber_sessions()
    recreate_sessions()


if __name__ == "__main__":
    main()
