#!/bin/sh
# This laptop runs without a battery, and the charger is 60W. Nothing absorbs
# the boost transients, so a CPU and iGPU burst together - a call plus a game -
# browns the machine out. Clamping the knobs is what stops the SoC from asking
# for watts the charger cannot deliver.
#
# Sourced by cfg/xorg/xinitrc, so no exit: that would take the session with it.

# -n rather than a prompt: nothing is watching this early in the session, and a
# sudo waiting for a password would hang the rest of xinitrc behind it.
if sudo -n true 2>/dev/null; then
    sudo -n sh -c '
        echo 0 >/sys/devices/system/cpu/cpufreq/boost
        for policy in /sys/devices/system/cpu/cpufreq/policy*; do
            echo 3000000 >"$policy/scaling_max_freq"
            echo power >"$policy/energy_performance_preference"
        done
        echo low-power >/sys/firmware/acpi/platform_profile
        for card in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
            echo low >"$card"
        done
    '
else
    echo "powercap: no passwordless sudo, power limits not applied" >&2
fi
