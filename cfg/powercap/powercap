#!/bin/sh
# Toggle the power limits described in cfg/powercap/start.
#
#   powercap on         clamp (what the session applies at startup)
#   powercap off        release, for anything that needs the whole 60W
#   powercap status     print the current knob values
#   powercap off -- cmd release, run cmd, clamp again when it exits
#
# Releasing browns the machine out under a CPU + iGPU burst, so it is meant to
# be held only as long as the work that needs it - hence the wrapper form.

set -e

apply_on() {
    sudo sh -c '
        echo 0 >/sys/devices/system/cpu/cpufreq/boost
        for policy in /sys/devices/system/cpu/cpufreq/policy*; do
            echo 3000000 >"$policy/scaling_max_freq"
            echo power >"$policy/energy_performance_preference"
        done
        echo low-power >/sys/firmware/acpi/platform_profile
        for card in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
            echo low >"$card"
        done
    '
}

apply_off() {
    sudo sh -c '
        echo 1 >/sys/devices/system/cpu/cpufreq/boost
        for policy in /sys/devices/system/cpu/cpufreq/policy*; do
            cat "$policy/cpuinfo_max_freq" >"$policy/scaling_max_freq"
            echo balance_performance >"$policy/energy_performance_preference"
        done
        echo balanced >/sys/firmware/acpi/platform_profile
        for card in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
            echo auto >"$card"
        done
    '
}

status() {
    printf 'boost: %s\n' "$(cat /sys/devices/system/cpu/cpufreq/boost)"
    printf 'max freq: %s kHz\n' \
        "$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq)"
    printf 'epp: %s\n' \
        "$(cat /sys/devices/system/cpu/cpufreq/policy0/energy_performance_preference)"
    printf 'platform: %s\n' "$(cat /sys/firmware/acpi/platform_profile)"
    for card in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        printf 'gpu (%s): %s\n' "$card" "$(cat "$card")"
    done
}

action=${1:-status}
[ $# -gt 0 ] && shift

case $action in
    on) apply_on ;;
    off)
        if [ "$1" = "--" ]; then
            shift
            [ $# -gt 0 ] || { echo "powercap: nothing to run" >&2; exit 2; }
            apply_off
            # Clamp again however the command ends, including a signal.
            trap apply_on EXIT INT TERM
            "$@"
        else
            apply_off
        fi
        ;;
    status) status ;;
    *)
        echo "usage: powercap [on|off|status] [-- command...]" >&2
        exit 2
        ;;
esac
