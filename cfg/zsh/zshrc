# autocomplete
autoload -Uz compinit                   # initialize autocompletion engine
autoload -Uz edit-command-line          # initialize additional modules
compinit -i                             # initialize autocompletion engine (2)
zstyle ':completion:*' matcher-list \
    'm:{a-zA-Z}={A-Za-z}' \
    '+l:|=* r:|=*'                      # recursive
setopt NO_NOMATCH                       # if extended glob fails, run cmd as-is
setopt NO_CASE_GLOB                     # ignore case in glob searches
setopt nullglob                         # nonexisting wildcards expand to ''
source ~/.zprofile
eval "$(zoxide init zsh)"


# color theme
# theme(1) writes the machine's theme to ~/.config/theme and renders every
# consumer's colors into ~/.config/theme.d - see cfg/theme/render.py. That
# marker is the only thing we read: never the terminal, and never what we
# inherited, which is a snapshot of some earlier theme and is how a pane comes
# up light on a black terminal. Export it so nothing downstream has to guess.
THEME=
[[ -r ~/.config/theme ]] && THEME=$(<~/.config/theme)
[[ $THEME == (light|dark) ]] || THEME=light
export THEME

# everything in this shell that depends on the theme, rebuilt from scratch.
# Called at the end of this file, once make_ps1 exists.
__apply_theme() {
    local fragment=~/.config/theme.d/$THEME.colors.zsh
    [[ -r $fragment ]] && source $fragment
    # The terminal is the one consumer that isn't on this machine - over ssh it
    # keeps its own ANSI 0-15, background and cursor, and never sees theme.d at
    # all. Hand it the palette as escapes; see cfg/theme/osc.py. theme(1) does
    # this for every client attached at the time, so this is for the panes that
    # start afterwards, and the .tmux copy is the same bytes tunnelled past a
    # pane's own tty. $(<...) is a builtin read, not a fork.
    if [[ -o interactive && -t 1 ]]; then
        local palette=~/.config/theme.d/$THEME.palette${TMUX:+.tmux}.osc
        [[ -r $palette ]] && print -rn -- "$(<$palette)"
    fi
    make_ps1
    [[ -n $__fzf_base_opts ]] \
        && export FZF_DEFAULT_OPTS="$__fzf_base_opts --color=$theme_fzf_colors"
    return 0
}

# theme(1) rewrites the marker and sends every zsh a WINCH - WINCH rather than
# USR1 because shells that predate this config redraw instead of dying. The
# precmd read catches the shells that were busy when the signal arrived.
__refresh_theme() {
    local was=$THEME
    [[ -r ~/.config/theme ]] && THEME=$(<~/.config/theme)
    [[ $THEME == (light|dark) ]] || THEME=$was
    [[ $THEME != $was ]] && __apply_theme
    return 0
}
TRAPWINCH() {
    __refresh_theme
    zle && zle reset-prompt
    return 0
}
precmd_functions+=(__refresh_theme)


# miscellaneous
unsetopt beep                           # disable beep on errors
setopt correct                          # enable [nyae] correction
setopt auto_cd                          # "cd /usr/" becomes "/usr/"
setopt nocasematch                      # regex should work case-insensitive
setopt magic_equal_subst                # enable path autocompletion after =
WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'      # what kill-word should delete

# history
HISTFILE=~/.config/zsh/history  # where to put the history
HISTSIZE=50000                  # how many entries in history (memory)
SAVEHIST=$HISTSIZE              # how many entries in history (hdd)
setopt appendhistory            # append lines (for concurrent sessions)
setopt extended_history         # record usage timestamps in the histfile
setopt inc_append_history       # write to the histfile immediately
setopt share_history            # share history between all sessions
setopt hist_ignore_all_dups     # delete old entry if new entry is a duplicate
setopt hist_find_no_dups        # do not display a line previously found
setopt hist_ignore_space        # discard entries that start with space
setopt hist_save_no_dups        # don't write duplicate entries in the histfile
setopt hist_reduce_blanks       # remove extra blanks before recording entry
setopt hist_verify              # don't execute immediately upon expansion

# don't remember certain commands
# `rg` and nothing else: `rg*` also swallowed rgb, and would swallow any
# other command that happens to start with those two letters
HISTORY_IGNORE="(plen*|enpl*|jaen*|tl*|edict*|reverso*|glosbe*|sjp*|urban*|rg|rg *)"
zshaddhistory() {
  emulate -L zsh
  [[ $1 != ${~HISTORY_IGNORE} ]]
}

# basic key bindings for interactive shells
if [[ $- == *i* ]]; then
    bindkey -e                # use Emacs keybindings
    bindkey "\e" vi-cmd-mode  # ...but allow going to Vi mode
    bindkey '^X^E' edit-command-line
    export KEYTIMEOUT=1       # ...and don't block other hotkeys for too long
    stty -ixon                # reclaim ctrl+q for Neovim
    stty stop undef           # reclaim ctrl+s for Neovim
fi

# key bindings for terminal emulator
if [ "$TERM" =~ rxvt ]; then
    bindkey "\e[3~"   delete-char         # delete
    bindkey '\e[1~'   beginning-of-line   # home and ctrl+home
    bindkey '\e[4~'   end-of-line         # end and ctrl+end
    bindkey '^H'      backward-kill-word  # ctrl+backspace
    bindkey "^[3^"    kill-word           # ctrl+delete
    bindkey '\eOd'    backward-word       # ctrl+left
    bindkey '\eOc'    forward-word        # ctrl+right

    bindkey '\e[1;5I' 'beep'              # disable ctrl+tab
    bindkey '\e[1;6I' 'beep'              # disable ctrl+shift+tab
else
    bindkey "\e[3~"   delete-char         # delete
    bindkey '\eOH'    beginning-of-line   # home
    bindkey '\eOF'    end-of-line         # end
    bindkey ';5H'     beginning-of-line   # ctrl+home
    bindkey ';5F'     end-of-line         # ctrl+end
    bindkey '^_'      backward-kill-word  # ctrl+backspace
    bindkey "\e[3;5~" kill-word           # ctrl+delete
    bindkey ';5D'     backward-word       # ctrl+left
    bindkey ';5C'     forward-word        # ctrl+right

    bindkey '\e[1;5I' 'beep'              # disable ctrl+tab
    bindkey '\e[1;6I' 'beep'              # disable ctrl+shift+tab
fi

# command prompt
__git_ps1 () {
    local g="$(command git rev-parse --git-dir 2>/dev/null)"
    if [ -n "$g" ]; then
        local r
        local b
        if [ -d "$g/rebase-apply" ]; then
            if test -f "$g/rebase-apply/rebasing"
            then
                r="|REBASE"
            elif test -f "$g/rebase-apply/applying"
            then
                r="|AM"
            else
                r="|AM/REBASE"
            fi
            b="$(command git symbolic-ref HEAD 2>/dev/null)"
        elif [ -f "$g/rebase-merge/interactive" ]; then
            r="|REBASE-i"
            b="$(cat "$g/rebase-merge/head-name")"
        elif [ -d "$g/rebase-merge" ]; then
            r="|REBASE-m"
            b="$(cat "$g/rebase-merge/head-name")"
        elif [ -f "$g/MERGE_HEAD" ]; then
            r="|MERGING"
            b="$(command git symbolic-ref HEAD 2>/dev/null)"
        else
            if [ -f "$g/BISECT_LOG" ]; then
                r="|BISECTING"
            fi
            if ! b="$(command git symbolic-ref HEAD 2>/dev/null)"; then
                if ! b="$(command git describe --exact-match HEAD 2>/dev/null)"; then
                    b="$(cut -c1-7 "$g/HEAD")..."
                fi
            fi
        fi

        if [ -n "${1-}" ]; then
            printf "$1" "${b##refs/heads/}$r"
        else
            printf "(%s)" "${b##refs/heads/}$r"
        fi
    fi
}

function make_ps1 () {
    # the colors come from ~/.config/theme.d/$THEME.colors.zsh, which
    # __apply_theme sourced just before calling us. color1 and color2 stay
    # global on purpose: PS1 expands them at prompt time
    local host=$(hostname)
    color1=${theme_ps1_host[$host]:-$theme_ps1_host[default]}
    color2=${theme_ps1_host2[$host]}

    # user@host
    PS1='${color1}%n@${color2}%m%b'

    # colon
    PS1+="$theme_ps1_punct:"

    # path relative to $HOME
    PS1+="$theme_ps1_path%~"

    # git prompt
    setopt prompt_subst
    PS1+="$theme_ps1_git"'`__git_ps1`'

    # colored $ depending on last exit code
    PS1+="%(?.$theme_ps1_ok.$theme_ps1_err)\$%f%k "

    # reset colors
    PS1+="%f"

    # add titlebar user@host:~/
    if [[ "$TERM" != linux ]]; then
        PS1+=$'%{\e]0;%n@%M:%~\007%}'
    fi
}
# config fzf
if [ -f ~/.fzf.zsh ]; then
    export FZF_DEFAULT_COMMAND='rg --files --hidden'
    # Kept apart from --color so that __apply_theme can rebuild the option,
    # and stripped of anything we added ourselves in a parent shell: its
    # --color describes the theme that shell was on, and both it and
    # --inline-info would otherwise fold in again at every level of nesting.
    __fzf_opts=(${(z)FZF_DEFAULT_OPTS})
    __fzf_opts=(${__fzf_opts:#(--color=*|--inline-info)})
    __fzf_base_opts="$__fzf_opts --inline-info"
    unset __fzf_opts
    export FZF_DEFAULT_OPTS="$__fzf_base_opts --color=$theme_fzf_colors"
    source ~/.fzf.zsh
    bindkey '\C-o' fzf-file-widget  # choose c-o for file opener
    bindkey '\C-t' transpose-chars  # restore default binding for c-t
fi

# don't be a nag when working with gui via ssh
if [ ! -v DISPLAY ]; then
    export DISPLAY=:0.0
fi

# set env variables for certain commands
export HOST_USER_UID=$(id -u)
export HOST_USER_GID=$(id -g)

# change cursor for vim insert mode
zle-line-init zle-keymap-select () {
    case $KEYMAP in
        vicmd)
            if [[ $TMUX = '' ]]; then
                echo -ne "\033]12;red\007"
            else
                printf '\033Ptmux;\033\033]12;red\007\033\\'
            fi
            ;;
        viins|main)
            if [[ $TMUX = '' ]]; then
                echo -ne "\033]112\007"
            else
                printf '\033Ptmux;\033\033]112\007\033\\'
            fi
            ;;
    esac
}
zle -N zle-line-init
zle -N zle-keymap-select
zle -N edit-command-line

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
if [[ -d $PYENV_ROOT/bin ]]; then
    export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init -)"
fi

# paint the prompt and friends now that everything they need is defined
__apply_theme
