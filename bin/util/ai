# Terminals without bracketed paste (or ones too slow to deliver a paste as a
# single chunk) hand us pasted text as plain key presses. Nothing arrives that
# fast from a human, so treat a burst of keys as a paste and keep treating keys
# as part of it for a short grace period, since a slow terminal splits one paste
# across several reads.
PASTE_KEY_INTERVAL = 0.01
PASTE_BURST_GRACE = 0.2

# "@path" in a prompt attaches the file and lets the model edit it back.
MENTION_RE = re.compile(r"@(\S+)")

# The model may look around under the working directory on its own. Symlinks
# are followed, so a link inside the tree can legitimately lead outside it.
ROOT = Path.cwd()
SKIP_DIRS = {".git", ".venv", "node_modules", "__pycache__"}
MAX_ENTRIES = 200
MAX_MATCHES = 100
MAX_READ_CHARS = 100_000
MAX_TOOL_ROUNDS = 25

# Git is read through the porcelain the model already knows, limited to the
# subcommands that only report. Anything writing a tree, a ref or a file is
# left out, so a diff can be inspected but not committed or redirected.
GIT_SUBCOMMANDS = {
    "blame",
    "branch",
    "diff",
    "log",
    "ls-files",
    "merge-base",
    "shortlog",
    "show",
    "status",
    "rev-parse",
}
