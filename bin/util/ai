Message = dict[str, Any]

# Every tool is a plain function; the decorator below turns its signature into
# the schema the API is given, so the two cannot drift apart.
TOOLS: dict[str, "Tool"] = {}
SCALAR_TYPES = {
    str: "string",
    int: "integer",
    float: "number",
    bool: "boolean",
}


def json_type(annotation: Any) -> dict[str, Any]:
    """Describe one parameter annotation the way the API asks for it."""
    if isinstance(annotation, UnionType):
        annotation = next(
            argument
            for argument in get_args(annotation)
            if argument is not type(None)
        )
    if get_origin(annotation) is list:
        return {
            "type": "array",
            "items": json_type(get_args(annotation)[0]),
        }
    return {"type": SCALAR_TYPES[annotation]}


@dc.dataclass
class Tool:
    function: Callable[..., str]
    schema: dict[str, Any]

    @property
    def properties(self) -> dict[str, Any]:
        return self.schema["function"]["parameters"]["properties"]

    def call(self, arguments: dict[str, Any]) -> str:
        typed = {}
        for name, value in arguments.items():
            # a model that means 3 sometimes says "3"
            if self.properties.get(name, {}).get("type") == "integer":
                value = int(value)
            typed[name] = value
        return self.function(**typed)


def tool(description: str, **parameter_docs: str) -> Callable:
    """Register a function as a tool the model may call."""

    def register(function: Callable[..., str]) -> Callable[..., str]:
        properties = {}
        required = []
        for name, parameter in inspect.signature(function).parameters.items():
            properties[name] = json_type(parameter.annotation)
            if name in parameter_docs:
                properties[name]["description"] = parameter_docs[name]
            if parameter.default is inspect.Parameter.empty:
                required.append(name)
        TOOLS[function.__name__] = Tool(
            function,
            {
                "type": "function",
                "function": {
                    "name": function.__name__,
                    "description": description,
                    "parameters": {
                        "type": "object",
                        "properties": properties,
                        "required": required,
                    },
                },
            },
        )
        return function

    return register


def get_model_info(model_name: str) -> ModelInfo | None:
    """Price a model by the longest listed name it starts with."""
    candidates = [
        model_info
        for model_info in MODEL_INFO
        if model_name.startswith(model_info.name)
    ]
    if not candidates:
        return None
    return max(candidates, key=lambda model_info: len(model_info.name))


@dc.dataclass
class ChatContext:
    client: OpenAI
    model: str
    temperature: float
    messages: list[Message] = dc.field(default_factory=list)

    @property
    def user_messages(self) -> list[Message]:
        return [
            message for message in self.messages if message["role"] == "user"
        ]

    @property
    def completion_messages(self) -> list[Message]:
        return [
            message for message in self.messages if message["role"] != "user"
        ]

    @property
    def prompt_tokens(self) -> int:
        return num_tokens_from_messages(self.user_messages, self.model)

    @property
    def completion_tokens(self) -> int:
        return num_tokens_from_messages(self.completion_messages, self.model)


@dc.dataclass
class Config:
    api_key: str = "INSERT API KEY HERE"
    model: str = "gpt-4o"
    temperature: float = 1.0


def load_config(config_file: Path) -> Config:
    """
    Read a YAML config file and returns its content as a dictionary.
    If the config file is missing, create one with default values.
    If the config file is present but missing keys, populate them with defaults.
    """
    # If the config file does not exist, create one with default configurations
    if not config_file.exists():
        config_file.parent.mkdir(exist_ok=True, parents=True)
        config_file.write_text(yaml.dump(dc.asdict(Config())))
        print(f"New config file initialized: {config_file}", file=sys.stderr)

    # Load existing config
    user_config = yaml.load(config_file.read_text(), Loader=yaml.FullLoader)

    # Fill missing values with defaults
    result = Config()
    for field in dc.fields(result):
        key = field.name
        keys_to_try = {key, key.replace("_", "-")}
        for user_key in keys_to_try:
            if user_key in user_config:
                setattr(result, key, user_config[user_key])
    return result


def save_history(context: ChatContext) -> None:
    """Save the conversation history in JSON format."""
    SAVE_FILE.parent.mkdir(exist_ok=True, parents=True)
    SAVE_FILE.write_text(
        json.dumps(
            {
                "model": context.model,
                "messages": context.messages,
                "prompt_tokens": context.prompt_tokens,
                "completion_tokens": context.completion_tokens,
            },
            indent=4,
            ensure_ascii=False,
        )
    )


def num_tokens_from_messages(messages: list[Message], model: str) -> int:
    """Returns the number of tokens used by a list of messages."""
    encoding = tiktoken.get_encoding("cl100k_base")
    num_tokens = 0
    for message in messages:
        for value in message.values():
            if isinstance(value, str):
                num_tokens += len(encoding.encode(value))
    return num_tokens


def calculate_expense(
    prompt_tokens: int,
    completion_tokens: int,
    input_pricing: Decimal,
    output_pricing: Decimal,
) -> Decimal:
    """
    Calculate the expense, given the number of tokens and the pricing rates
    """
    return (
        Decimal(prompt_tokens) * input_pricing
        + Decimal(completion_tokens) * output_pricing
    ) / TOKENS_PER_PRICE_UNIT


def session_expense(context: ChatContext) -> Decimal | None:
    """What the conversation so far is estimated to have cost."""
    model_info = get_model_info(context.model)
    if model_info is None:
        return None
    return calculate_expense(
        context.prompt_tokens,
        context.completion_tokens,
        model_info.input,
        model_info.output,
    )


def display_expense(context: ChatContext) -> None:
    """
    Given the model used, display total tokens used and estimated expense
    """
    print(
        f"\nTotal tokens used: {context.prompt_tokens + context.completion_tokens}",
        file=sys.stderr,
    )

    if (total_expense := session_expense(context)) is not None:
        print(f"Estimated expense: ${total_expense:.6f}", file=sys.stderr)
    else:
        print(
            f"No expense estimate available for model {context.model}",
            file=sys.stderr,
        )


def sandbox_path(raw_path: str) -> Path:
    """Resolve a model-supplied path, keeping the entry point under ROOT."""
    path = Path(raw_path).expanduser()
    if not path.is_absolute():
        path = ROOT / path
    # Normalise ".." lexically so a symlink is allowed to point outside the
    # tree while a literal escape from it is not.
    normalised = Path(os.path.normpath(path))
    if normalised != ROOT and ROOT not in normalised.parents:
        raise ValueError(f"{raw_path} is outside {ROOT}")
    return normalised


def show(path: Path) -> str:
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def truncated(lines: list[str], limit: int) -> str:
    if len(lines) > limit:
        extra = len(lines) - limit
        lines = lines[:limit] + [f"... {extra} more omitted"]
    return "\n".join(lines) or "(nothing found)"


@tool(
    "List the entries of a directory under the working directory.",
    path="Defaults to the working directory.",
)
def list_dir(path: str = ".") -> str:
    directory = sandbox_path(path)
    if directory.is_file():
        return f"{show(directory)} is a file; read_file reads it."
    if not directory.is_dir():
        return f"{show(directory)} does not exist."
    entries = sorted(
        (f"{entry.name}/" if entry.is_dir() else entry.name)
        for entry in directory.iterdir()
    )
    return truncated(entries, MAX_ENTRIES)


@tool(
    "Read a text file under the working directory, or just the lines from "
    "'start' to 'end' of it.",
    start="First line to read, counting from 1.",
    end="Last line to read, inclusive.",
)
def read_file(
    path: str, start: int | None = None, end: int | None = None
) -> str:
    file = sandbox_path(path)
    if file.is_dir():
        return f"{show(file)} is a directory; list_dir lists it."
    if not file.is_file():
        return f"{show(file)} does not exist."
    try:
        content = file.read_text()
    except UnicodeDecodeError:
        return f"{show(file)} is not text."

    lines = content.splitlines()
    if start is not None or end is not None:
        first = max(1, start or 1)
        last = min(len(lines), end or len(lines))
        if first > len(lines):
            return f"{show(file)} has only {len(lines)} lines."
        header = f"{show(file)} lines {first}-{last} of {len(lines)}:\n"
        content = header + "\n".join(lines[first - 1 : last])

    if len(content) > MAX_READ_CHARS:
        content = (
            content[:MAX_READ_CHARS]
            + f"\n... truncated; {show(file)} has {len(lines)} lines, "
            "read the rest by passing start and end"
        )
    return content


def walk_files(path: Path):
    if path.is_file():
        yield path
        return
    for entry in sorted(path.rglob("*")):
        if any(part in SKIP_DIRS for part in entry.parts):
            continue
        if entry.is_file():
            yield entry


@tool("Find files by glob pattern, e.g. '**/*.py'.")
def find_files(pattern: str) -> str:
    matches = [
        show(match)
        for match in sorted(ROOT.glob(pattern))
        if not any(part in SKIP_DIRS for part in match.parts)
    ]
    return truncated(matches, MAX_ENTRIES)


def grep_file(file: Path, regex: re.Pattern[str], context: int) -> list[str]:
    """Report the matching lines of one file, grep(1) style."""
    try:
        lines = file.read_text().splitlines()
    except (OSError, UnicodeDecodeError):
        return []

    wanted: dict[int, bool] = {}
    for number, line in enumerate(lines, 1):
        if not regex.search(line):
            continue
        for around in range(number - context, number + context + 1):
            if 1 <= around <= len(lines):
                wanted.setdefault(around, False)
        wanted[number] = True

    output = []
    previous = 0
    for number in sorted(wanted):
        if previous and number > previous + 1:
            output.append("--")
        separator = ":" if wanted[number] else "-"
        text = lines[number - 1].strip()[:200]
        output.append(f"{show(file)}:{number}{separator} {text}")
        previous = number
    return output


@tool(
    "Search file contents for a regular expression.",
    path="File or directory to search.",
    context="Lines of context to show around each match.",
)
def grep(pattern: str, path: str = ".", context: int = 0) -> str:
    regex = re.compile(pattern)
    root = sandbox_path(path)
    context = max(0, min(context, MAX_CONTEXT_LINES))
    matches: list[str] = []
    for file in walk_files(root):
        matches.extend(grep_file(file, regex, context))
        if len(matches) > MAX_MATCHES:
            break
    return truncated(matches, MAX_MATCHES)


@tool(
    "Run a read-only git command in the working directory, e.g. "
    "['diff', 'main...HEAD'] for the changes on this branch. Allowed "
    "subcommands: " + ", ".join(sorted(GIT_SUBCOMMANDS)) + ".",
    arguments="Arguments after 'git'.",
)
def git(arguments: list[str]) -> str:
    if not arguments:
        return "Pass a git subcommand."
    if arguments[0] not in GIT_SUBCOMMANDS:
        allowed = ", ".join(sorted(GIT_SUBCOMMANDS))
        return f"git {arguments[0]} is not allowed. Allowed: {allowed}."
    if any(argument.startswith(("-o", "--output")) for argument in arguments):
        return "Redirecting git output to a file is not allowed."
    result = subprocess.run(
        ["git", "--no-pager", *arguments],
        cwd=ROOT,
        capture_output=True,
        text=True,
        timeout=GIT_TIMEOUT,
    )
    output = (result.stdout + result.stderr).strip()
    if len(output) > MAX_READ_CHARS:
        output = output[:MAX_READ_CHARS] + "\n... truncated"
    return output or f"(no output, exit status {result.returncode})"


def read_command(path: Path) -> tuple[str, str]:
    """Split a command file into its description and its prompt body."""
    text = path.read_text()
    description = ""
    if match := FRONTMATTER_RE.match(text):
        meta = yaml.safe_load(match.group(1)) or {}
        description = str(meta.get("description", "")).strip()
        text = text[match.end() :]
    return description, text.strip()


def list_commands() -> list[tuple[str, str]]:
    """Every command file, as (name, description) pairs."""
    commands = []
    for path in sorted(COMMANDS_DIR.glob("*.md")):
        try:
            description, _ = read_command(path)
        except (OSError, UnicodeDecodeError, yaml.YAMLError) as error:
            print(f"Could not read {path}: {error}", file=sys.stderr)
            continue
        commands.append((path.stem, description))
    return commands


def print_commands() -> None:
    commands = list_commands()
    if not commands:
        print(f"No commands in {COMMANDS_DIR}.", file=sys.stderr)
        return
    width = max(len(name) for name, _ in commands)
    for name, description in commands:
        print(f"/{name:<{width}}  {description}", file=sys.stderr)


def expand_command(message: str) -> str | None:
    """Replace a leading "/name" with the prompt its command file holds.

    Returns the message unchanged when it names no command, and None when
    there is nothing left to send: /help printed the list, or the command
    does not exist.
    """
    match = COMMAND_RE.match(message.strip())
    if not match:
        return message
    name, arguments = match.group(1), (match.group(2) or "").strip()

    if name == "help":
        print_commands()
        return None

    path = COMMANDS_DIR / f"{name}.md"
    if not path.is_file():
        print(f"No command named /{name}; /help lists them.", file=sys.stderr)
        return None

    print(f"Command: {show(path)}", file=sys.stderr)
    _, body = read_command(path)
    if "$ARGUMENTS" in body:
        return body.replace("$ARGUMENTS", arguments)
    return f"{body}\n\n{arguments}".strip()


def expand_mentions(message: str) -> str:
    """Inline the contents of every readable @path in the message."""
    attachments = []
    for match in MENTION_RE.finditer(message):
        path = Path(match.group(1).rstrip(".,;:)]}")).expanduser()
        if not path.is_file():
            continue
        try:
            content = path.read_text()
        except (OSError, UnicodeDecodeError) as error:
            print(f"Could not read {path}: {error}", file=sys.stderr)
            continue
        print(f"Attached: {path}", file=sys.stderr)
        attachments.append(f"=== {path} ===\n{content}")

    if not attachments:
        return message
    return message + "\n\n" + "\n\n".join(attachments)


def confirm(diff: str, question: str) -> bool:
    """Show a change and let the user accept it."""
    if not sys.stdin.isatty() and not ASSUME_YES[0]:
        return False
    print(file=sys.stderr)
    print(diff, file=sys.stderr)
    if ASSUME_YES[0]:
        return True
    try:
        return input(f"\n{question} [y/N] ").strip().lower() == "y"
    except EOFError:
        return False


def confirm_write(path: Path, old: str, new: str) -> bool:
    diff = "".join(
        difflib.unified_diff(
            old.splitlines(keepends=True),
            new.splitlines(keepends=True),
            fromfile=str(path),
            tofile=str(path),
        )
    )
    return confirm(diff, f"Apply to {path}?")


REJECTED = (
    "The change was not applied: the user rejected it, or there is no "
    "terminal to confirm it on (rerun with --yes to allow unattended "
    "writes)."
)


def run_git_apply(patch: str, flags: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "apply", *flags, "-"],
        cwd=ROOT,
        input=patch,
        capture_output=True,
        text=True,
        timeout=GIT_TIMEOUT,
    )


PATCH_PATH_RE = re.compile(r"^[-+]{3} (?:[ab]/)?(.+?)\s*$", re.MULTILINE)


@tool(
    "Apply a unified diff to files under the working directory, the way "
    "'git apply' would. Use it to change several places at once; paths in "
    "the diff are relative to the working directory. The user confirms "
    "every patch.",
    patch="The diff, with ---/+++ headers and @@ hunks.",
)
def apply_patch(patch: str) -> str:
    """Hand a unified diff to git, after checking where it points."""
    if not patch.endswith("\n"):
        patch += "\n"
    for raw_path in PATCH_PATH_RE.findall(patch):
        if raw_path == "/dev/null":
            continue
        sandbox_path(raw_path)
    check = run_git_apply(patch, ["--check"])
    if check.returncode:
        return f"The patch does not apply:\n{check.stderr.strip()}"
    if not confirm(patch, "Apply this patch?"):
        return REJECTED
    result = run_git_apply(patch, [])
    if result.returncode:
        return f"The patch failed to apply:\n{result.stderr.strip()}"
    return "Patch applied."


@tool(
    "Write a file under the working directory, creating it if needed. The "
    "user confirms every write."
)
def write_file(path: str, content: str) -> str:
    file = sandbox_path(path)
    old = file.read_text() if file.exists() else ""
    if old == content:
        return "No change: file already has these contents."
    if not confirm_write(file, old, content):
        return REJECTED
    file.parent.mkdir(parents=True, exist_ok=True)
    file.write_text(content)
    return f"Wrote {file}."


@tool(
    "Replace an exact, unique snippet in a file under the working "
    "directory. Prefer this over write_file."
)
def edit_file(path: str, old: str, new: str) -> str:
    text = sandbox_path(path).read_text()
    occurrences = text.count(old)
    if occurrences == 0:
        return "The old snippet was not found in the file."
    if occurrences > 1:
        return f"The old snippet appears {occurrences} times; make it unique."
    return write_file(path, text.replace(old, new, 1))


def run_tool_call(call: dict) -> str:
    name = call["function"]["name"]
    try:
        arguments = json.loads(call["function"]["arguments"] or "{}")
        print(f"[{name} {arguments}]", file=sys.stderr, flush=True)
        if name not in TOOLS:
            return f"Unknown tool {name}."
        return TOOLS[name].call(arguments)
    except (
        ValueError,
        KeyError,
        TypeError,
        OSError,
        re.error,
        subprocess.SubprocessError,
    ) as error:
        return f"Error: {error}"


def collect_stream(result) -> tuple[str, list[dict]]:
    """Consume a streamed completion into its text and its tool calls."""
    output = ""
    calls: list[dict] = []
    for chunk in result:
        delta = chunk.choices[0].delta
        if delta.content:
            print(delta.content, end="", flush=True)
            output += delta.content
        for part in delta.tool_calls or []:
            while len(calls) <= part.index:
                calls.append(
                    {
                        "id": "",
                        "type": "function",
                        "function": {"name": "", "arguments": ""},
                    }
                )
            call = calls[part.index]
            if part.id:
                call["id"] = part.id
            if part.function and part.function.name:
                call["function"]["name"] += part.function.name
            if part.function and part.function.arguments:
                call["function"]["arguments"] += part.function.arguments
    return output, calls


def create_completion(context: ChatContext, tools: list, stream: bool):
    """Ask for a completion, giving up the model's reasoning if it insists."""
    arguments: dict[str, Any] = {
        "model": context.model,
        "messages": context.messages,
        "temperature": context.temperature,
        "stream": stream,
        "tools": tools,
    }
    if NO_REASONING[0]:
        arguments["reasoning_effort"] = "none"
    try:
        return context.client.chat.completions.create(**arguments)
    except BadRequestError as error:
        if NO_REASONING[0] or "reasoning_effort" not in str(error):
            raise
        print(
            "\nThe model will not use tools while reasoning; "
            "asking it again without.",
            file=sys.stderr,
        )
        NO_REASONING[0] = True
        return context.client.chat.completions.create(
            **arguments, reasoning_effort="none"
        )


def stub_old_tool_results(messages: list[Message]) -> None:
    """Leave a note where an older tool result used to be."""
    calls = {
        call["id"]: call["function"]
        for message in messages
        for call in message.get("tool_calls", [])
    }
    results = [
        message for message in messages if message["role"] == "tool"
    ]
    for message in results[:-KEEP_TOOL_RESULTS]:
        content = message["content"]
        if len(content) < MIN_STUB_CHARS or content.startswith("[dropped "):
            continue
        call = calls.get(message["tool_call_id"], {})
        name = call.get("name", "a tool")
        arguments = call.get("arguments", "")
        message["content"] = (
            f"[dropped {len(content)} characters of {name} {arguments} "
            "output; call it again if you still need it]"
        )


def run_prompt(
    context: ChatContext, message: str, stream: bool = True
) -> None:
    """Ask the user for input, build the request and perform it."""
    expanded = expand_command(message)
    if expanded is None:
        return
    context.messages.append(
        {"role": "user", "content": expand_mentions(expanded)}
    )

    tools = [entry.schema for entry in TOOLS.values()]
    for _ in range(MAX_TOOL_ROUNDS):
        stub_old_tool_results(context.messages)
        result = create_completion(context, tools, stream)

        if stream:
            try:
                output, calls = collect_stream(result)
            except KeyboardInterrupt:
                result.response.close()
                return
            result.response.close()
        else:
            choice = result.choices[0].message
            output = choice.content or ""
            calls = [call.model_dump() for call in (choice.tool_calls or [])]
            print(output, end="", flush=True)

        reply: Message = {"role": "assistant", "content": output}
        if calls:
            reply["tool_calls"] = calls
        context.messages.append(reply)

        if not calls:
            return

        for call in calls:
            context.messages.append(
                {
                    "role": "tool",
                    "tool_call_id": call["id"],
                    "content": run_tool_call(call),
                }
            )

    print(f"\nStopped after {MAX_TOOL_ROUNDS} tool rounds.", file=sys.stderr)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "prompt",
        nargs="*",
        help="Prompt to send; appended to piped input if any",
    )
    parser.add_argument(
        "-c", "--context", nargs="+", help="Additional context"
    )
    parser.add_argument(
        "-C",
        "--context-path",
        type=Path,
        nargs="+",
        help="Path to a context file",
    )
    parser.add_argument("-m", "--model", help="Set the model")
    parser.add_argument(
        "-t",
        "--temperature",
        type=float,
        help="Set the temperature (default: 1)",
        default=1.0,
    )
    parser.add_argument(
        "-ml",
        "--multiline",
        action="store_true",
        help="Use the multiline input mode",
    )
    parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Apply file writes without confirmation",
    )
    parser.add_argument(
        "-l",
        "--list-models",
        action="store_true",
        help="List the available models",
    )
    return parser.parse_args()


class PromptCompleter(Completer):
    """Complete the @mention or the leading /command being typed."""

    def __init__(self) -> None:
        self.paths = PathCompleter(expanduser=True)

    def get_completions(
        self, document: Document, complete_event: CompleteEvent
    ):
        text = document.text_before_cursor
        if match := re.fullmatch(r"/([A-Za-z0-9_-]*)", text):
            prefix = match.group(1)
            commands = [("help", "List the commands")] + list_commands()
            for name, description in commands:
                if name.startswith(prefix):
                    yield Completion(
                        name,
                        start_position=-len(prefix),
                        display_meta=description,
                    )
            return
        if match := re.search(r"@(\S*)$", text):
            prefix = match.group(1)
            yield from self.paths.get_completions(
                Document(prefix, len(prefix)), complete_event
            )


class PasteDetector:
    """Guess whether the key currently being handled came from a paste."""

    def __init__(
        self,
        interval: float = PASTE_KEY_INTERVAL,
        grace: float = PASTE_BURST_GRACE,
    ) -> None:
        self.interval = interval
        self.grace = grace
        self.last_key_time = 0.0
        self.burst_until = 0.0

    def observe(self, *_: object) -> None:
        now = time.monotonic()
        if now - self.last_key_time < self.interval:
            self.burst_until = now + self.grace
        self.last_key_time = now

    def in_paste(self, event: KeyPressEvent) -> bool:
        # More keys already buffered behind this one: definitely not typed.
        if event.app.key_processor.input_queue:
            return True
        return time.monotonic() <= self.burst_until


def stdin_has_data() -> bool:
    return select.select([sys.stdin], [], [], 0) == ([sys.stdin], [], [])


def run_interactive(context: ChatContext, args: argparse.Namespace) -> None:
    is_multiline = [args.multiline]
    multiline = Condition(lambda: is_multiline[0])
    paste = PasteDetector()
    kb = KeyBindings()

    @kb.add("escape", "m")  # type: ignore
    def handle_alt_m(event: KeyPressEvent) -> None:
        is_multiline[0] = not is_multiline[0]

    @kb.add("c-m", filter=HasFocus(DEFAULT_BUFFER) & multiline)  # type: ignore
    def handle_newline_multiline(event: KeyPressEvent) -> None:
        event.app.current_buffer.newline()

    @kb.add("c-m", filter=HasFocus(DEFAULT_BUFFER) & ~multiline)  # type: ignore
    def handle_newline_single_line(event: KeyPressEvent) -> None:
        if paste.in_paste(event):
            # copy_margin would re-indent lines that already carry their own.
            event.app.current_buffer.newline(copy_margin=False)
        else:
            event.app.current_buffer.validate_and_handle()

    @kb.add("c-j", filter=HasFocus(DEFAULT_BUFFER))  # type: ignore
    def handle_ctrl_j(event: KeyPressEvent) -> None:
        event.app.current_buffer.newline()

    @kb.add(Keys.BracketedPaste, filter=HasFocus(DEFAULT_BUFFER) & ~multiline)  # type: ignore
    def handle_single_line_paste(event: KeyPressEvent) -> None:
        data = event.data.replace("\r\n", "\n").replace("\r", "\n")
        event.app.current_buffer.insert_text(data)

    history = FileHistory(HISTORY_FILE)
    session = PromptSession(
        history=history,
        multiline=True,
        key_bindings=kb,
        completer=PromptCompleter(),
        complete_while_typing=True,
    )
    session.app.key_processor.before_key_press += paste.observe

    def get_prompt() -> HTML:
        prompt = ">>>" if is_multiline[0] else ">"
        return HTML(
            f"<b>[{context.prompt_tokens + context.completion_tokens}] {prompt}</b> "
        )

    print("ChatGPT CLI", file=sys.stderr)
    print(f"Model in use: {context.model}", file=sys.stderr)
    if list_commands():
        print("/help lists the saved commands.", file=sys.stderr)

    atexit.register(display_expense, context=context)

    while True:
        try:
            print(file=sys.stderr)
            message = session.prompt(get_prompt)

            if message.lower() == ".exit":
                raise EOFError
            if message.lower() == "":
                raise KeyboardInterrupt

            before = session_expense(context)
            run_prompt(context, message, stream=True)
            after = session_expense(context)
            print(file=sys.stderr)
            if before is not None and after is not None:
                print(
                    f"\n(this turn ${after - before:.4f}, "
                    f"session ${after:.4f})",
                    file=sys.stderr,
                )
            print(file=sys.stderr)
        except KeyboardInterrupt:
            continue
        except EOFError:
            break
    save_history(context)


def run_non_interactive(
    context: ChatContext, args: argparse.Namespace
) -> None:
    parts = []
    if stdin_has_data():
        parts.append(sys.stdin.read().strip())
    if args.prompt:
        parts.append(" ".join(args.prompt).strip())

    message = "\n\n".join(part for part in parts if part)
    run_prompt(context, message, stream=False)
    save_history(context)


def main() -> None:
    args = parse_args()
    ASSUME_YES[0] = args.yes

    try:
        config = load_config(CONFIG_FILE)
    except FileNotFoundError:
        print("Configuration file not found", file=sys.stderr)
        sys.exit(1)

    if args.model:
        config.model = args.model
    if args.temperature is not None:
        config.temperature = args.temperature

    messages: list[Message] = [
        {
            "role": "system",
            "content": WORKING_DIRECTORY_PROMPT.format(root=ROOT),
        }
    ]
    if args.context_path:
        for path in args.context_path:
            print(f"Context file: {path.name}", file=sys.stderr)
            messages.append(
                {"role": "system", "content": path.read_text().strip()}
            )
    elif args.context:
        for text in args.context:
            print(f"Context: {text}", file=sys.stderr)
            messages.append({"role": "system", "content": text.strip()})
    elif (path := SYSTEM_PROMPT_FILE).exists():
        print(f"Context file: {path.name}", file=sys.stderr)
        messages.append(
            {"role": "system", "content": path.read_text().strip()}
        )

    client = OpenAI(api_key=config.api_key)
    if args.list_models:
        models = client.models.list()
        for model in models:
            print(model.id)
        exit(0)

    context = ChatContext(
        client=client,
        model=config.model,
        temperature=config.temperature,
        messages=messages,
    )

    if args.prompt or stdin_has_data():
        run_non_interactive(context, args)
    else:
        run_interactive(context, args)


if __name__ == "__main__":
    main()
