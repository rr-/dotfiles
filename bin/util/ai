MAX_MATCHES = 100
MAX_READ_CHARS = 20_000
MAX_TOOL_ROUNDS = 25

# Every round of a tool loop resends the whole conversation, so the file read
# in the first round is paid for again in each of the ones that follow. Keep
# the newest results, which is what the model is still working from, and leave
# a stub where the older ones were.
KEEP_TOOL_RESULTS = 3
MIN_STUB_CHARS = 500

