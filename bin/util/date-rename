#!/usr/bin/env python3
import argparse
import random
import string
from datetime import datetime
from pathlib import Path


def expand_dirs(paths: list[Path]) -> list[Path]:
    expanded = []
    for path in paths:
        if path.is_dir():
            expanded.extend(sorted(p for p in path.iterdir() if p.is_file()))
        else:
            expanded.append(path)
    return expanded


def rename_files(paths: list[Path], discard: bool, dry_run: bool) -> None:
    for path in expand_dirs(paths):
        timestamp = datetime.fromtimestamp(path.stat().st_mtime).strftime(
            "%Y%m%d_%H%M%S"
        )
        if discard:
            rand_chars = "".join(random.choices(string.ascii_lowercase, k=3))
            stem = f"{timestamp}_{rand_chars}"
        else:
            stem = f"{timestamp}_{path.stem}"
        new_path = path.with_name(f"{stem}{path.suffix}")
        print(f"{path} → {new_path}")
        if not dry_run:
            path.rename(new_path)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("files", nargs="+", type=Path)
    parser.add_argument(
        "--discard",
        action=argparse.BooleanOptionalAction,
        default=False,
        help="drop the original name instead of keeping it after the timestamp",
    )
    parser.add_argument("-d", "--dry-run", action="store_true")
    args = parser.parse_args()
    rename_files(args.files, args.discard, args.dry_run)


if __name__ == "__main__":
    main()
