"""Review a branch's commits in the diff viewer, one comment at a time.

    git review [<range>]
    git review list [<range>] [--all]
    git review prune [<range>]

Comments and approvals go to review.jsonl in the repository's .git, for
whoever fixes the commits to read and answer. `git review --help` gives
the file's format. The code lives in opt/diffview.
"""

import sys

from diffview.cli import review_main

review_main(sys.argv[1:])
