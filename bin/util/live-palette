#!/usr/bin/env python3
"""Run a command with the rgb colors it prints tied to the terminal palette.

codex asks the terminal for its default colors once at startup and paints the
composer, user messages and diffs in rgb worked out from them, so after a
theme switch they stay on the old theme. Each rgb that is a palette color of
the theme we started on goes out as that palette index instead, and a gray
near one as the nearest step of the gray ramp, which the themes mirror. The
terminal palette follows a switch (cfg/theme/osc.py), so they follow too.
Everything else passes through untouched.

    live-palette codex --sandbox workspace-write
"""

import fcntl
import os
import pty
import re
import select
import signal
import sys
import termios
import tomllib
import tty
from pathlib import Path

COLORS_DIR = Path(__file__).resolve().parents[2] / "cfg" / "wezterm" / "colors"
THEME_MARKER = Path.home() / ".config" / "theme"

SGR = re.compile(rb"\x1b\[([0-9;]*)m")
# the start of an SGR that the next read may finish
PARTIAL = re.compile(rb"\x1b(?:\[[0-9;]*)?\Z")
GRAY_RAMP = range(232, 256)
# how far off the ramp a gray may be and still be taken for its nearest step
GRAY_SLACK = 6

Rgb = tuple[int, int, int]


def to_rgb(color: str) -> Rgb:
    value = color.lstrip("#")
    return int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16)


def load_palette() -> tuple[dict[int, Rgb], Rgb, Rgb]:
    """The palette of the theme this machine is on: indices, fg, bg."""
    theme = "light"
    if THEME_MARKER.exists():
        theme = THEME_MARKER.read_text().strip() or theme
    with (COLORS_DIR / f"dash_{theme}.toml").open("rb") as handle:
        colors = tomllib.load(handle)["colors"]
    palette = {int(k): to_rgb(v) for k, v in colors["indexed"].items()}
    for index, color in enumerate(colors["ansi"]):
        palette[index] = to_rgb(color)
    for index, color in enumerate(colors["brights"]):
        palette[index + 8] = to_rgb(color)
    return palette, to_rgb(colors["foreground"]), to_rgb(colors["background"])


class Mapper:
    def __init__(self) -> None:
        palette, self.fg, self.bg = load_palette()
        # the gray ramp first, so a gray lands where the themes mirror it
        order = [*GRAY_RAMP, *range(16, 232), *range(16)]
        self.exact: dict[Rgb, int] = {}
        for index in order:
            if index in palette:
                self.exact.setdefault(palette[index], index)
        self.ramp = [(index, palette[index]) for index in GRAY_RAMP]

    def index_for(self, rgb: Rgb) -> int | None:
        if rgb in self.exact:
            return self.exact[rgb]
        if max(rgb) - min(rgb) > 2:
            return None  # not a gray
        index, step = min(self.ramp, key=lambda item: abs(item[1][0] - rgb[0]))
        return index if abs(step[0] - rgb[0]) <= GRAY_SLACK else None

    def params(self, text: bytes) -> bytes:
        """Rewrite the 38;2;r;g;b and 48;2;r;g;b inside one SGR."""
        parts = text.split(b";")
        out: list[bytes] = []
        i = 0
        while i < len(parts):
            part = parts[i]
            if part in (b"38", b"48") and parts[i + 1 : i + 2] == [b"2"]:
                try:
                    rgb = tuple(int(x) for x in parts[i + 2 : i + 5])
                except ValueError:
                    rgb = ()
                if len(rgb) == 3:
                    out.append(self.color(part == b"48", rgb))
                    i += 5
                    continue
            out.append(part)
            i += 1
        return b";".join(out)

    def color(self, background: bool, rgb: tuple[int, ...]) -> bytes:
        default = self.bg if background else self.fg
        if rgb == default:
            return b"49" if background else b"39"
        index = self.index_for(rgb)  # type: ignore[arg-type]
        if index is None:
            return b"%d;2;%d;%d;%d" % (48 if background else 38, *rgb)
        return b"%d;5;%d" % (48 if background else 38, index)

    def rewrite(self, data: bytes) -> bytes:
        return SGR.sub(lambda m: b"\x1b[" + self.params(m[1]) + b"m", data)


def winsize(fd: int) -> bytes:
    return fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)


def split_tail(data: bytes) -> tuple[bytes, bytes]:
    """Keep back an unfinished SGR at the very end, for the next read."""
    match = PARTIAL.search(data)
    if match is None:
        return data, b""
    return data[: match.start()], data[match.start() :]


def write_all(fd: int, data: bytes) -> None:
    while data:
        data = data[os.write(fd, data) :]


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if not os.isatty(0):
        os.execvp(sys.argv[1], sys.argv[1:])

    mapper = Mapper()
    size = winsize(0)
    pid, master = pty.fork()
    if pid == 0:
        fcntl.ioctl(0, termios.TIOCSWINSZ, size)
        os.execvp(sys.argv[1], sys.argv[1:])

    def resize(*_: object) -> None:
        # the kernel hands the child its own SIGWINCH for this
        try:
            fcntl.ioctl(master, termios.TIOCSWINSZ, winsize(0))
        except OSError:
            pass

    signal.signal(signal.SIGWINCH, resize)
    saved = termios.tcgetattr(0)
    tty.setraw(0)
    pending = b""
    try:
        while True:
            try:
                ready, _, _ = select.select(
                    [0, master], [], [], 0.05 if pending else None
                )
            except InterruptedError:
                continue
            if not ready and pending:
                write_all(1, pending)
                pending = b""
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError:
                    break  # EIO: the child closed its side
                if not data:
                    break
                data, pending = split_tail(pending + data)
                write_all(1, mapper.rewrite(data))
            if 0 in ready:
                data = os.read(0, 65536)
                if not data:
                    break
                write_all(master, data)
    finally:
        write_all(1, mapper.rewrite(pending))
        termios.tcsetattr(0, termios.TCSAFLUSH, saved)

    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


if __name__ == "__main__":
    sys.exit(main())
