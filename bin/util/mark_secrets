#!/usr/bin/env python3
"""Mark the secrets of a config file for aes-edit.

Reads a file on stdin and writes it to stdout with every value that looks
secret wrapped in !encrypt(...), ready for `aes-edit --encrypt --agent`.
It understands KEY=VALUE (env, ini, toml), key: value (yaml), htpasswd
lines and files that are one secret as a whole (private keys, tokens).
On stderr it lists, by line number, each key it marks and why, never a
value, so the choices can be checked without seeing the secrets; -v lists
the keys it leaves plain too.
"""

import math
import re
import sys
from collections import Counter

TOKEN = "encrypt"
GROUPS = {"(": ")", "[": "]", "{": "}", "<": ">"}
SECRET_NAME = re.compile(
    r"pass|pwd|secret|token|api_?key|apikey|private|credential|auth|"
    r"webhook|dsn|salt|cookie|session_?key|signing|access_?key|"
    r"client_?secret|refresh|(^|_)key$",
    re.IGNORECASE,
)
ASSIGNMENT = re.compile(
    r"^(?P<lead>\s*(?:export\s+)?)(?P<key>[A-Za-z0-9_.-]+)"
    r"(?P<sep>\s*[=:]\s*)(?P<value>.*?)(?P<trail>\s*)$"
)
HTPASSWD = re.compile(r"^(?P<lead>[^:\s#]+:)(?P<value>(\$|\{[A-Z0-9-]+\})\S+)$")
PASSWORD_HASH = re.compile(
    r"^(\{[A-Z0-9-]+\}|\$[0-9a-z]+\$|pbkdf2:|scrypt:|argon2)", re.IGNORECASE
)
USERINFO_URL = re.compile(r"^[a-z][a-z0-9+.-]*://[^/\s:@]+:[^@\s]+@", re.I)
HARMLESS = re.compile(
    r"^(true|false|yes|no|on|off|none|null|\d+(\.\d+)?|[~./].*|unix:.*)$",
    re.IGNORECASE,
)


def entropy(text: str) -> float:
    counts = Counter(text)
    return -sum(n / len(text) * math.log2(n / len(text)) for n in counts.values())


def looks_random(value: str) -> bool:
    return (
        len(value) >= 20
        and re.fullmatch(r"[A-Za-z0-9+/=_.\-]+", value) is not None
        and re.search(r"\d", value) is not None
        and re.search(r"[A-Za-z]", value) is not None
        and entropy(value) >= 3.5
    )


def verdict(key: str, value: str) -> str | None:
    """Why the value is secret, or None."""
    if not value or HARMLESS.match(value):
        return None
    if PASSWORD_HASH.match(value):
        return "password or its hash"
    if USERINFO_URL.match(value):
        return "url with a password"
    if "/webhooks/" in value or re.search(r"[?&](token|key|sig)=", value):
        return "url with a token"
    if SECRET_NAME.search(key):
        return "name"
    if looks_random(value):
        return "random-looking value"
    return None


def wrap(text: str) -> str:
    for opener, closer in GROUPS.items():
        depth = 0
        for char in text:
            depth += (char == opener) - (char == closer)
            if depth < 0:
                break
        else:
            if depth == 0:
                return f"!{TOKEN}{opener}{text}{closer}"
    raise ValueError("no kind of brackets is balanced in this value")


def unquote(value: str) -> tuple[str, str, str]:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[0], value[1:-1], value[0]
    return "", value, ""


def mark(text: str, report: list[str]) -> str:
    lines = text.splitlines(keepends=True)
    structured = [
        line
        for line in lines
        if line.strip() and not line.lstrip().startswith(("#", ";", "//", "["))
    ]
    if text.lstrip().startswith("-----BEGIN") or (
        len(structured) == 1
        and not ASSIGNMENT.match(structured[0].rstrip("\n"))
        and not HTPASSWD.match(structured[0].rstrip("\n"))
    ):
        body = text.rstrip("\n")
        report.append("(whole file): secret, one secret as a whole")
        return wrap(body) + text[len(body) :]

    out = []
    for number, line in enumerate(lines, 1):
        content = line.rstrip("\n")
        newline = line[len(content) :]
        stripped = content.lstrip()
        if not stripped or stripped.startswith(("#", ";", "//", "[")):
            out.append(line)
            continue
        if match := HTPASSWD.match(content):
            report.append(
                f"line {number}: {match['lead'][:-1]}: secret, password or its hash"
            )
            out.append(match["lead"] + wrap(match["value"]) + newline)
            continue
        match = ASSIGNMENT.match(content)
        if match is None or match["value"].startswith(("|", ">", "{", "[")):
            out.append(line)
            continue
        quote, value, end = unquote(match["value"])
        reason = verdict(match["key"], value)
        report.append(
            f"line {number}: {match['key']}: "
            + (f"secret, {reason}" if reason else "plain")
        )
        if reason:
            value = wrap(value)
        out.append(
            match["lead"]
            + match["key"]
            + match["sep"]
            + quote
            + value
            + end
            + match["trail"]
            + newline
        )
    return "".join(out)


def main() -> None:
    verbose = "-v" in sys.argv[1:]
    report: list[str] = []
    sys.stdout.write(mark(sys.stdin.read(), report))
    shown = [line for line in report if verbose or ": secret" in line]
    if not any(": secret" in line for line in report):
        shown.append("nothing secret")
    sys.stderr.write("".join(f"  {line}\n" for line in shown))


if __name__ == "__main__":
    main()
