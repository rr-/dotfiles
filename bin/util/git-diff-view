# --- syntax highlighting ----------------------------------------------------

LEXER_OPTIONS = {"stripnl": False, "ensurenl": True}


def lexer_from_shebang(line: str) -> Lexer | None:
    if not line.startswith("#!"):
        return None
    words = [w for w in line[2:].split() if not w.startswith("-")]
    words = [w for w in words if "=" not in w]
    if words and Path(words[0]).name == "env":
        words = words[1:]
    if not words:
        return None
    name = re.sub(r"[\d.]+$", "", Path(words[0]).name)
    name = {"uv": "python", "node": "javascript"}.get(name, name)
    try:
        return get_lexer_by_name(name, **LEXER_OPTIONS)
    except ClassNotFound:
        return None


def pick_lexer(f: FileDiff, root: Path | None) -> Lexer | None:
    try:
        return get_lexer_for_filename(f.path, **LEXER_OPTIONS)
    except ClassNotFound:
        pass
    for hunk in f.hunks:
        for line in hunk.lines:
            if (line.new == 1 and line.kind == "+") or line.old == 1:
                return lexer_from_shebang(line.text)
    if root is not None:
        try:
            with (root / f.path).open(errors="replace") as handle:
                return lexer_from_shebang(handle.readline())
        except OSError:
            pass
    return None


def split_token_lines(
    tokens: list[tuple[_TokenType, str]], count: int
) -> list[list[tuple[_TokenType, str]]]:
    out: list[list[tuple[_TokenType, str]]] = [[]]
    for ttype, value in tokens:
        for i, part in enumerate(value.split("\n")):
            if i:
                out.append([])
            if part:
                out[-1].append((ttype, part))
    return (out + [[]] * count)[:count]


WORD_RE = re.compile(r"\w+|\s+|[^\w\s]")


def emph_ranges(
    a: str, b: str
) -> tuple[list[tuple[int, int]], list[tuple[int, int]]] | None:
    """The spans that differ between a removed line and its replacement."""
    wa = [(m.start(), m.end()) for m in WORD_RE.finditer(a)]
    wb = [(m.start(), m.end()) for m in WORD_RE.finditer(b)]
    matcher = difflib.SequenceMatcher(
        None, [a[s:e] for s, e in wa], [b[s:e] for s, e in wb], autojunk=False
    )
    if matcher.ratio() < 0.4:
        return None
    ra: list[tuple[int, int]] = []
    rb: list[tuple[int, int]] = []
    for op, i1, i2, j1, j2 in matcher.get_opcodes():
        if op == "equal":
            continue
        if i1 < i2:
            ra.append((wa[i1][0], wa[i2 - 1][1]))
        if j1 < j2:
            rb.append((wb[j1][0], wb[j2 - 1][1]))
    return ra, rb


@dc.dataclass
class Highlight:
    tokens: dict[tuple[int, int], list[tuple[_TokenType, str]]]
    emph: dict[tuple[int, int], list[tuple[int, int]]]


def highlight_file(f: FileDiff, root: Path | None) -> Highlight:
    tokens: dict[tuple[int, int], list[tuple[_TokenType, str]]] = {}
    emph: dict[tuple[int, int], list[tuple[int, int]]] = {}

    lexer = None if f.binary else pick_lexer(f, root)
    if lexer is not None:
        # Each side reads as one stretch of code, so a string or comment that
        # opens in one line still colors the lines after it.
        for kinds in (" +", "-"):
            keys = [
                (hi, li)
                for hi, hunk in enumerate(f.hunks)
                for li, line in enumerate(hunk.lines)
                if line.kind in kinds
            ]
            if not keys:
                continue
            source = "\n".join(
                f.hunks[hi].lines[li].text.replace("\r", " ")
                for hi, li in keys
            )
            lines = split_token_lines(
                list(lexer.get_tokens(source)), len(keys)
            )
            tokens.update(zip(keys, lines))

    for hi, hunk in enumerate(f.hunks):
        lines = hunk.lines
        i = 0
        while i < len(lines):
            if lines[i].kind != "-":
                i += 1
                continue
            j = i
            while j < len(lines) and lines[j].kind == "-":
                j += 1
            k = j
            while k < len(lines) and lines[k].kind == "+":
                k += 1
            for a, b in zip(range(i, j), range(j, k)):
                ranges = emph_ranges(lines[a].text, lines[b].text)
                if ranges:
                    emph[hi, a], emph[hi, b] = ranges
            i = k
    return Highlight(tokens, emph)


# --- tree -------------------------------------------------------------------


@dc.dataclass(eq=False)
class Node:
    name: str
    parent: "Node | None" = None
    file: int | None = None
    children: dict[str, "Node"] = dc.field(default_factory=dict)
    expanded: bool = True
    commit: bool = False
    rank: int = 0
    message: int | None = None  # the commit whose message this leaf opens

    @property
    def is_dir(self) -> bool:
        return self.file is None and self.message is None

    def sorted_children(self) -> list["Node"]:
        def key(n: Node) -> tuple:
            kind = 0 if n.message is not None else 1 if n.is_dir else 2
            return (kind, n.rank, n.name, n.file or 0)

        return sorted(self.children.values(), key=key)


def build_tree(files: list[FileDiff], commits: list[Commit]) -> Node:
    root = Node("")
    grouped = len({f.commit for f in files} | set(range(len(commits)))) > 1

    def group(ci: int) -> Node:
        if not grouped:
            return root
        # Short names: the tree is as wide as its widest entry.
        name = "no commit"
        if ci >= 0:
            name = commits[ci].sha[:7] or f"commit {ci + 1}"
        return root.children.setdefault(
            f"c:{ci}", Node(name, parent=root, commit=True, rank=ci)
        )

    for ci in range(len(commits)):
        parent = group(ci)
        parent.children[f"m:{ci}"] = Node("message", parent=parent, message=ci)
    for fi, f in enumerate(files):
        node = group(f.commit)
        *dirs, name = f.path.split("/")
        for part in dirs:
            node = node.children.setdefault(
                f"d:{part}", Node(part, parent=node)
            )
        node.children[f"f:{name}:{fi}"] = Node(name, parent=node, file=fi)

    def squash(node: Node) -> None:
        for child in node.children.values():
            while (
                child.is_dir and not child.commit and len(child.children) == 1
            ):
                (only,) = child.children.values()
                if not only.is_dir:
                    break
                child.name += "/" + only.name
                child.children = only.children
                for grandchild in child.children.values():
                    grandchild.parent = child
            squash(child)

    squash(root)
    return root


def walk_tree(node: Node, depth: int = 0, everything: bool = False):
    for child in node.sorted_children():
        yield depth, child
        if child.is_dir and (child.expanded or everything):
            yield from walk_tree(child, depth + 1, everything)


def tree_guides(node: Node, depth: int) -> str:
    """Box-drawing guides for a row, two cells per level below the top."""

    def last(n: Node) -> bool:
        return n.parent.sorted_children()[-1] is n

    if depth == 0:
        return ""
    guides = ["└─" if last(node) else "├─"]
    n = node.parent
    for _ in range(depth - 1):
        guides.append("  " if last(n) else "│ ")
        n = n.parent
    return "".join(reversed(guides))


# --- terminal ---------------------------------------------------------------


def cwidth(ch: str) -> int:
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def expand(chars: list[tuple[str, Style]]) -> list[tuple[str, int, Style]]:
    """Lay text out in cells: tabs become spaces, control bytes become ^X."""
    out: list[tuple[str, int, Style]] = []
    col = 0
    for ch, style in chars:
        if ch == "\t":
            n = TAB - col % TAB
            out.extend([(" ", 1, style)] * n)
            col += n
        elif ord(ch) < 32 or ch == "\x7f":
            faint = style._replace(fg=role("text.faint"))
            out += [("^", 1, faint), (chr(ord(ch) ^ 64), 1, faint)]
            col += 2
        else:
            w = cwidth(ch)
            out.append((ch, w, style))
            col += w
    return out


class LineBuf:
    def __init__(self, width: int) -> None:
        self.width = width
        self.col = 0
        self.parts: list[str] = []
        self.last: Style | None = None

    def put(self, ch: str, w: int, style: Style) -> bool:
        if self.col + w > self.width:
            return False
        if style != self.last:
            self.parts.append(sgr(style))
            self.last = style
        self.parts.append(ch)
        self.col += w
        return True

    def add(self, text: str, style: Style) -> None:
        for ch, w, st in expand([(ch, style) for ch in text]):
            if not self.put(ch, w, st):
                break

    def add_clipped(self, text: str, style: Style, room: int) -> None:
        """Add text, cut with an ellipsis if it is wider than room."""
        if sum(cwidth(ch) for ch in text) > room:
            while text and sum(cwidth(ch) for ch in text) > room - 1:
                text = text[:-1]
            text += "…"
        self.add(text, style)

    def fill(self, style: Style, upto: int | None = None) -> None:
        upto = self.width if upto is None else min(upto, self.width)
        while self.col < upto:
            self.put(" ", 1, style)

    def render(self) -> str:
        return "".join(self.parts) + "\x1b[0m"


KEYS_CSI = {
    "A": "up",
    "B": "down",
    "C": "right",
    "D": "left",
    "H": "home",
    "F": "end",
    "1~": "home",
    "7~": "home",
    "4~": "end",
    "8~": "end",
    "3~": "delete",
    "5~": "pgup",
    "6~": "pgdn",
}


class Terminal:
    ENTER = "\x1b[?1049h\x1b[?25l\x1b[?7l"
    LEAVE = "\x1b[?7h\x1b[?25h\x1b[?1049l"

    def __enter__(self) -> "Terminal":
        self.fd = os.open("/dev/tty", os.O_RDWR)
        self.saved = termios.tcgetattr(self.fd)
        self.buf = b""
        self.wake_r, self.wake_w = os.pipe()
        os.set_blocking(self.wake_w, False)
        signal.signal(signal.SIGWINCH, lambda *_: self._wake())
        self.resume()
        return self

    def __exit__(self, *_) -> None:
        self.suspend()
        signal.signal(signal.SIGWINCH, signal.SIG_DFL)
        os.close(self.fd)

    def _wake(self) -> None:
        try:
            os.write(self.wake_w, b"x")
        except BlockingIOError:
            pass

    def suspend(self) -> None:
        self.write(self.LEAVE)
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)

    def resume(self) -> None:
        tty.setraw(self.fd)
        self.write(self.ENTER)

    def write(self, text: str) -> None:
        data = text.encode()
        while data:
            data = data[os.write(self.fd, data) :]

    def size(self) -> tuple[int, int]:
        size = os.get_terminal_size(self.fd)
        return size.columns, size.lines

    def _fill(self, timeout: float | None) -> bool:
        ready, _, _ = select.select([self.fd, self.wake_r], [], [], timeout)
        if self.wake_r in ready:
            os.read(self.wake_r, 1024)
        if self.fd in ready:
            self.buf += os.read(self.fd, 4096)
            return True
        return False

    def read_key(self) -> str | None:
        """The next key, or None when the terminal was resized."""
        if not self.buf and not self._fill(None):
            return None
        if self.buf[:1] == b"\x1b":
            if len(self.buf) == 1:
                self._fill(0.03)
            m = re.match(
                rb"\x1b(?:\[([0-9;]*[~A-Za-z])|O([A-Za-z]))", self.buf
            )
            if m:
                self.buf = self.buf[m.end() :]
                code = (m[1] or m[2]).decode()
                return KEYS_CSI.get(code, f"<{code}>")
            self.buf = self.buf[1:]
            return "esc"
        lead = self.buf[0]
        need = (
            1 if lead < 0xC0 else 2 if lead < 0xE0 else 3 if lead < 0xF0 else 4
        )
        while len(self.buf) < need and self._fill(0.05):
            pass
        chunk, self.buf = self.buf[:need], self.buf[need:]
        ch = chunk.decode(errors="replace")
        if ch == "\r":
            return "enter"
        if ch == "\t":
            return "tab"
        if ch in "\x7f\x08":
            return "backspace"
        if len(ch) == 1 and ord(ch) < 32:
            return f"C-{chr(ord(ch) + 96)}"
        return ch


# --- app --------------------------------------------------------------------


@dc.dataclass
class Row:
    kind: str  # "file", "meta", "hunk", "line" or "commit"
    file: int
    hunk: int = 0
    line: int = 0
    text: str = ""
    tone: str = ""  # how a commit message row is drawn
    page: int = 0


class Quit(Exception):
    pass


class App:
    def __init__(self, git_args: list[str] | None, text: str) -> None:
        self.git_args = git_args
        self.root = git_root()
        self.folded: set[str] = set()
        self.cur = self.top = self.hscroll = 0
        self.focus = "diff"
        self.show_tree = True
        self.tree_cur = 0
        self.tree_top = 0
        self.count = ""
        self.pending = ""
        self.prompt: tuple[str, str] | None = None
        self.search: tuple[re.Pattern, int] | None = None
        self.message = ("", PLAIN)
        self.show_help = False
        self.width, self.height = 80, 24
        self.wrap_width = 0
        self.base_context = self.context = initial_context(git_args)
        self.full = False
        # Each file's hunks per -U, when they come from re-diffing blobs.
        self.hunk_cache: dict[
            tuple[int, int], tuple[list[Hunk], int, int]
        ] = {}
        self.load(text)

    # model

    def load(self, text: str) -> None:
        files, self.commits = parse_diff(text)
        tree = build_tree(files, self.commits)
        order = [
            n.file
            for _, n in walk_tree(tree, everything=True)
            if n.file is not None
        ]
        self.files = [files[i] for i in order]
        self.tree = build_tree(self.files, self.commits)
        self.highlights: dict[int, Highlight] = {}
        self.build_rows()

    def build_rows(self) -> None:
        # The diff pane shows one page at a time: a commit's message, or one
        # file. C-j and C-k walk the pages in tree order.
        self.rows: list[Row] = []
        self.pages: list[tuple[str, int]] = []
        self.spans: list[tuple[int, int]] = []
        self.file_rows: list[int] = []
        self.file_page: dict[int, int] = {}
        self.commit_page: dict[int, int] = {}
        shown = -1

        def add_page(kind: str, index: int, rows: list[Row]) -> int:
            page = len(self.pages)
            self.pages.append((kind, index))
            self.spans.append((len(self.rows), len(self.rows) + len(rows) - 1))
            for row in rows:
                row.page = page
            self.rows += rows
            return page

        def add_commits(upto: int) -> None:
            nonlocal shown
            for ci in range(shown + 1, upto + 1):
                rows = self.message_rows(ci)
                self.commit_page[ci] = add_page("commit", ci, rows)
            shown = max(shown, upto)

        for fi, f in enumerate(self.files):
            add_commits(f.commit)
            self.file_rows.append(len(self.rows))
            rows = [Row("file", fi)]
            if f.path not in self.folded:
                rows += [Row("meta", fi, text=m) for m in f.meta]
                for hi, hunk in enumerate(f.hunks):
                    if hunk.header:
                        rows.append(Row("hunk", fi, hi))
                    rows += [
                        Row("line", fi, hi, li)
                        for li in range(len(hunk.lines))
                    ]
            self.file_page[fi] = add_page("file", fi, rows)
        add_commits(len(self.commits) - 1)

        width = max(
            (
                len(str(n))
                for f in self.files
                for h in f.hunks
                for line in h.lines
                for n in (line.old, line.new)
                if n is not None
            ),
            default=1,
        )
        self.num_width = max(width, 3)

    def message_rows(self, ci: int) -> list[Row]:
        commit = self.commits[ci]
        width = self.wrap_width - 4 if self.wrap_width > 24 else 10**6
        texts: list[tuple[str, str]] = []
        if not commit.sha:  # some --format we don't know: show it as is
            texts = [("subject", commit.lines[0])]
            texts += [("", line) for line in commit.lines[1:]]
        else:
            head = " ".join([commit.sha, commit.author, commit.date])
            texts.append(("head", head))
            texts += [("dim", line) for line in commit.headers]
            texts.append(("", ""))
            last_para = len(commit.message)
            while last_para and commit.message[last_para - 1].strip():
                last_para -= 1
            trailers = all(
                TRAILER_RE.match(line) for line in commit.message[last_para:]
            )
            for i, line in enumerate(commit.message):
                tone = "subject" if i == 0 else ""
                if trailers and i >= last_para and last_para:
                    tone = "dim"
                texts += [(tone, part) for part in wrap(line, width)]
            if commit.extra:
                texts.append(("", ""))
                texts += [("dim", line) for line in commit.extra]
        return [
            Row("commit", -1, ci, li, text, tone)
            for li, (tone, text) in enumerate(texts)
        ]

    def rewrap(self, width: int) -> None:
        """Rebuild the message pages for a new pane width."""
        if width == self.wrap_width or not self.commits:
            self.wrap_width = width
            return
        page = self.current_page()
        lo = self.spans[page][0]
        cur, top = self.cur - lo, self.top - lo
        self.wrap_width = width
        self.build_rows()
        lo, hi = self.spans[page]
        self.cur = min(lo + cur, hi)
        self.top = min(lo + top, hi)

    def reload(self) -> None:
        if self.git_args is None:
            self.flash(
                "can't rerun a diff that came from stdin", "state.error"
            )
            return
        mark = self.mark()
        self.load(run_git_diff(self.diff_args()))
        if not self.files:
            raise Quit("no changes left")
        self.restore(mark)
        self.flash("reloaded")

    def mark(self) -> tuple:
        """Where the cursor is, in terms that survive rebuilding the rows."""
        row = self.rows[self.cur]
        offset = self.cur - self.spans[row.page][0]
        if row.file < 0:
            return row.page, offset, None, None
        f = self.files[row.file]
        line = None
        if row.kind == "line":
            at = f.hunks[row.hunk].lines[row.line]
            line = (at.old, at.new)
        return row.page, offset, f.path, line

    def restore(self, mark: tuple) -> None:
        page, offset, path, line = mark
        page = self.clamp(page, 0, len(self.pages) - 1)
        kind, index = self.pages[page]
        if path is not None and (
            kind != "file" or self.files[index].path != path
        ):
            for fi, f in enumerate(self.files):
                if f.path == path:
                    page = self.file_page[fi]
                    break
        lo, hi = self.spans[page]
        self.cur = min(lo + offset, hi)
        if line is not None:
            old, new = line
            for i in range(lo, hi + 1):
                row = self.rows[i]
                if row.kind != "line":
                    continue
                at = self.files[row.file].hunks[row.hunk].lines[row.line]
                if new is not None:
                    found = at.new is not None and at.new >= new
                else:
                    found = at.old is not None and at.old >= old
                if found:
                    self.cur = i
                    break
        self.set_cur(self.cur, "center")

    # context

    @property
    def unified(self) -> int:
        return FULL_CONTEXT if self.full else self.context

    def diff_args(self) -> list[str]:
        args = list(self.git_args)
        if self.unified != self.base_context:
            # Before any `--`, where it would read as a path.
            at = args.index("--") if "--" in args else len(args)
            args.insert(at, f"-U{self.unified}")
        return args

    def set_context(self, context: int, full: bool) -> None:
        context = max(0, context)
        if (context, full) == (self.context, self.full):
            return
        mark = self.mark()
        self.context, self.full = context, full
        failed = 0
        if self.git_args is not None:
            self.load(run_git_diff(self.diff_args()))
            if not self.files:
                raise Quit("no changes left")
        else:
            # From stdin there is no command to rerun, so each file is diffed
            # again from the blobs named on its index line.
            for fi, f in enumerate(self.files):
                if not self.recontext(fi, f):
                    failed += 1
            self.highlights = {}
            self.build_rows()
        self.restore(mark)
        what = "full file" if self.full else f"context {self.context}"
        if failed:
            noun = "file" if failed == 1 else "files"
            self.flash(
                f"{what}, but {failed} {noun} kept theirs: blobs not found",
                "state.warning",
            )
        else:
            self.flash(what)

    def recontext(self, fi: int, f: FileDiff) -> bool:
        if f.blobs is None or f.binary or f.status in "AD" or not f.hunks:
            return True  # nothing more to show
        cache = self.hunk_cache
        original = (f.hunks, f.added, f.deleted)
        cache.setdefault((fi, self.base_context), original)
        if (fi, self.unified) not in cache:
            proc = subprocess.run(
                [
                    "git",
                    "diff",
                    "--no-color",
                    "--no-ext-diff",
                    f"-U{self.unified}",
                    *f.blobs,
                ],
                capture_output=True,
            )
            if proc.returncode not in (0, 1):
                return False
            files, _ = parse_diff(proc.stdout.decode(errors="replace"))
            if not files:
                return False
            new = files[0]
            cache[fi, self.unified] = (new.hunks, new.added, new.deleted)
        f.hunks, f.added, f.deleted = cache[fi, self.unified]
        return True

    def highlight(self, fi: int) -> Highlight:
        if fi not in self.highlights:
            self.highlights[fi] = highlight_file(self.files[fi], self.root)
        return self.highlights[fi]

    def anchor(self, row: Row) -> int:
        if row.file < 0:
            return 1
        f = self.files[row.file]
        if row.kind in ("hunk", "line") and f.hunks:
            hunk = f.hunks[row.hunk]
            return (
                hunk.lines[row.line].anchor
                if row.kind == "line"
                else hunk.new_start
            )
        return 1

    # geometry

    @property
    def body_h(self) -> int:
        return max(2, self.height - 1)

    @property
    def view_h(self) -> int:
        """Rows for the page, less the commit line pinned above a file."""
        return self.body_h - (1 if self.pinned_commit() is not None else 0)

    def pinned_commit(self) -> Commit | None:
        fi = self.current_file()
        if fi is None or self.files[fi].commit < 0:
            return None
        commit = self.commits[self.files[fi].commit]
        return commit if commit.sha else None

    @property
    def tree_visible(self) -> bool:
        return self.show_tree and self.width >= 50

    def tree_width(self) -> int:
        widest = max(
            (
                depth * 2 + 2 + len(node.name) + (1 if node.is_dir else 0)
                for depth, node in walk_tree(self.tree, everything=True)
            ),
            default=10,
        )
        return max(16, min(widest + 2, self.width // 3))

    # cursor

    def clamp(self, n: int, lo: int, hi: int) -> int:
        return max(lo, min(n, hi))

    @property
    def span(self) -> tuple[int, int]:
        return self.spans[self.current_page()]

    def move(self, row: int, align: str | None = None) -> None:
        """Move the cursor without leaving the current page."""
        self.set_cur(self.clamp(row, *self.span), align)

    def set_cur(self, row: int, align: str | None = None) -> None:
        self.cur = self.clamp(row, 0, len(self.rows) - 1)
        h = self.view_h
        if align == "top":
            self.top = self.cur
        elif align == "center" or (
            align == "jump" and not self.top <= self.cur < self.top + h
        ):
            self.top = self.cur - h // 2
        self.follow()

    def follow(self) -> None:
        h = self.view_h
        if self.cur < self.top:
            self.top = self.cur
        if self.cur >= self.top + h:
            self.top = self.cur - h + 1
        lo, hi = self.span
        self.top = self.clamp(self.top, lo, max(lo, hi - h + 1))

    def scroll(self, delta: int, move_cursor: bool) -> None:
        h = self.view_h
        lo, hi = self.span
        self.top = self.clamp(self.top + delta, lo, max(lo, hi - h + 1))
        if move_cursor:
            self.cur = self.clamp(self.cur + delta, lo, hi)
        self.cur = self.clamp(self.cur, self.top, min(self.top + h - 1, hi))

    def current_page(self) -> int:
        return self.rows[self.cur].page

    def current_file(self) -> int | None:
        fi = self.rows[self.cur].file
        return fi if fi >= 0 else None

    def goto_page(self, page: int) -> None:
        page = self.clamp(page, 0, len(self.pages) - 1)
        self.set_cur(self.spans[page][0], "top")

    def goto_file(self, fi: int) -> None:
        self.goto_page(self.file_page[fi])

    def goto_next(self, kind: str, step: int) -> None:
        """Jump to the next hunk or commit header."""
        rng = (
            range(self.cur + 1, len(self.rows))
            if step > 0
            else range(self.cur - 1, -1, -1)
        )
        for i in rng:
            row = self.rows[i]
            if row.kind == kind and (kind != "commit" or row.line == 0):
                self.set_cur(i, "top" if kind == "commit" else "jump")
                return
        self.flash(f"no more {kind}s", "state.warning")

    def goto_line(self, n: int) -> None:
        fi = self.current_file()
        if fi is None:
            self.flash("not on a file", "state.error")
            return
        lo, hi = self.span
        best = lo
        for i in range(lo, hi + 1):
            row = self.rows[i]
            if row.kind != "line":
                continue
            line = self.files[fi].hunks[row.hunk].lines[row.line]
            if line.new is not None and line.new <= n:
                best = i
            if line.new is not None and line.new >= n:
                break
        self.set_cur(best, "jump")

    def toggle_fold(
        self, paths: set[str] | None = None, fold: bool | None = None
    ) -> None:
        fi = self.current_file()
        page = self.current_page()
        if paths is None:
            if fi is None:
                self.flash("only files fold", "state.error")
                return
            self.folded ^= {self.files[fi].path}
        elif fold:
            self.folded |= paths
        else:
            self.folded -= paths
        self.build_rows()
        self.set_cur(self.spans[page][0])

    # tree

    def tree_rows(self) -> list[tuple[int, Node]]:
        return list(walk_tree(self.tree))

    def node_page(self, node: Node) -> int | None:
        if node.file is not None:
            return self.file_page[node.file]
        if node.message is not None:
            return self.commit_page[node.message]
        return None

    def sync_tree(self) -> None:
        page = self.current_page()
        node = next(
            n
            for _, n in walk_tree(self.tree, everything=True)
            if self.node_page(n) == page
        )
        parent = node.parent
        while parent is not None:
            parent.expanded = True
            parent = parent.parent
        self.tree_cur = [n for _, n in self.tree_rows()].index(node)

    def tree_move(self, index: int) -> None:
        rows = self.tree_rows()
        self.tree_cur = self.clamp(index, 0, len(rows) - 1)
        page = self.node_page(rows[self.tree_cur][1])
        if page is not None and page != self.current_page():
            self.goto_page(page)

    def tree_key(self, key: str, n: int | None) -> None:
        rows = self.tree_rows()
        node = rows[self.tree_cur][1]
        if key in ("j", "down", "C-n"):
            self.tree_move(self.tree_cur + (n or 1))
        elif key in ("k", "up", "C-p"):
            self.tree_move(self.tree_cur - (n or 1))
        elif key == "gg":
            self.tree_move(0)
        elif key == "G":
            self.tree_move(len(rows) - 1)
        elif key in ("enter", "o", "l", "right", " "):
            if node.is_dir:
                node.expanded = not node.expanded if key != "l" else True
            else:
                self.goto_page(self.node_page(node))
                if key in ("enter", "o", "l", "right"):
                    self.focus = "diff"
        elif key in ("h", "left"):
            if node.is_dir and node.expanded:
                node.expanded = False
            elif node.parent is not self.tree:
                self.tree_cur = [n for _, n in rows].index(node.parent)
        else:
            return
        self.pending = ""

    # input

    def flash(self, text: str, color: str | None = None) -> None:
        self.message = (text, Style(fg=role(color) if color else None))

    def handle(self, key: str) -> None:
        if self.show_help:
            self.show_help = False
            return
        if self.prompt is not None:
            self.prompt_key(key)
            return
        self.message = ("", PLAIN)

        if key.isdigit() and (self.count or key != "0") and not self.pending:
            self.count += key
            return
        n = int(self.count) if self.count else None
        self.count = ""

        if self.pending == "C-w":
            self.pending = ""
            if key in ("h", "C-h", "left"):
                self.focus = "tree" if self.tree_visible else "diff"
            elif key in ("l", "C-l", "right"):
                self.focus = "diff"
            elif key in ("w", "C-w"):
                self.toggle_focus()
            return
        if self.pending:
            key, self.pending = self.pending + key, ""
        elif key in ("g", "z", "Z", "[", "]", "C-w"):
            self.pending = key
            return

        if self.focus == "tree" and self.tree_visible:
            self.tree_key(key, n)
            if key in (
                "j",
                "k",
                "down",
                "up",
                "C-n",
                "C-p",
                "gg",
                "G",
                "enter",
                "o",
                "l",
                "h",
                "left",
                "right",
                " ",
            ):
                return
        self.common_key(key, n)
        self.sync_tree()

    def toggle_focus(self) -> None:
        if self.focus == "diff" and self.tree_visible:
            self.focus = "tree"
            self.sync_tree()
        else:
            self.focus = "diff"

    def common_key(self, key: str, n: int | None) -> None:
        h = self.view_h
        lo, hi = self.span
        match key:
            case "q" | "ZZ" | "ZQ" | "C-c":
                raise Quit()
            case "j" | "down" | "C-n" | "enter":
                self.move(self.cur + (n or 1))
            case "k" | "up" | "C-p":
                self.move(self.cur - (n or 1))
            case "C-d":
                self.scroll(n or h // 2, True)
            case "C-u":
                self.scroll(-(n or h // 2), True)
            case "C-f" | "pgdn" | " ":
                self.scroll(max(1, h - 2) * (n or 1), True)
            case "C-b" | "pgup":
                self.scroll(-max(1, h - 2) * (n or 1), True)
            case "C-e":
                self.scroll(n or 1, False)
            case "C-y":
                self.scroll(-(n or 1), False)
            case "gg" | "home":
                self.move(lo + (n or 1) - 1, "jump")
            case "G" | "end":
                self.move(lo + n - 1 if n else hi, "jump")
            case "H":
                self.move(self.top + (n or 1) - 1)
            case "M":
                self.move(self.top + (min(h, hi - self.top + 1) - 1) // 2)
            case "L":
                self.move(min(self.top + h - 1, hi) - (n or 1) + 1)
            case "zz":
                self.set_cur(self.cur, "center")
            case "zt":
                self.set_cur(self.cur, "top")
            case "zb":
                self.top = self.cur - h + 1
                self.follow()
            case "h" | "left" | "zh":
                self.hscroll = max(0, self.hscroll - (n or 8))
            case "l" | "right" | "zl":
                self.hscroll += n or 8
            case "0":
                self.hscroll = 0
            case "$":
                self.hscroll = max(
                    0, self.widest_line() - self.diff_width() + 12
                )
            case "C-j" | "J" | "]f":
                self.goto_page(self.current_page() + (n or 1))
            case "C-k" | "K" | "[f":
                self.goto_page(self.current_page() - (n or 1))
            case "}" | "]c":
                for _ in range(n or 1):
                    self.goto_next("hunk", 1)
            case "{" | "[c":
                for _ in range(n or 1):
                    self.goto_next("hunk", -1)
            case "]]":
                for _ in range(n or 1):
                    self.goto_next("commit", 1)
            case "[[":
                for _ in range(n or 1):
                    self.goto_next("commit", -1)
            case "za":
                self.toggle_fold()
            case "zM":
                self.toggle_fold({f.path for f in self.files}, True)
            case "zR":
                self.toggle_fold(set(self.folded), False)
            case "tab":
                self.toggle_focus()
            case "t":
                self.show_tree = not self.show_tree
                self.focus = "diff"
            case "/" | "?" | ":":
                self.prompt = (key, "")
            case "n":
                self.search_next(1)
            case "N":
                self.search_next(-1)
            case "e":
                self.edit()
            case "r":
                self.reload()
            case "+":
                self.set_context(self.context + (n or CONTEXT_STEP), False)
            case "-":
                self.set_context(self.context - (n or CONTEXT_STEP), False)
            case "=":
                self.set_context(self.base_context, False)
            case "F":
                self.set_context(self.context, not self.full)
            case "C-l":
                pass
            case _:
                if key not in ("esc",):
                    self.flash(
                        f"{key} does nothing - :h for help", "text.faint"
                    )

    def prompt_key(self, key: str) -> None:
        kind, text = self.prompt
        if key in ("esc", "C-c") or (key == "backspace" and not text):
            self.prompt = None
        elif key == "backspace":
            self.prompt = (kind, text[:-1])
        elif key == "C-u":
            self.prompt = (kind, "")
        elif key == "C-w":
            self.prompt = (kind, re.sub(r"\S*\s*$", "", text))
        elif key == "enter":
            self.prompt = None
            if kind == ":":
                self.command(text.strip())
            elif text or self.search:
                self.start_search(text, 1 if kind == "/" else -1)
        elif len(key) == 1:
            self.prompt = (kind, text + key)

    def command(self, cmd: str) -> None:
        if cmd.isdigit():
            self.goto_line(int(cmd))
        elif cmd in ("q", "q!", "qa", "qa!", "quit", "x"):
            raise Quit()
        elif cmd in ("h", "help"):
            self.show_help = True
        elif cmd:
            self.flash(f"not a command: {cmd}", "state.error")

    def start_search(self, pattern: str, direction: int) -> None:
        if pattern:
            try:
                flags = re.I if pattern == pattern.lower() else 0
                self.search = (re.compile(pattern, flags), direction)
            except re.error as ex:
                self.flash(f"bad pattern: {ex}", "state.error")
                return
        else:
            self.search = (self.search[0], direction)
        self.search_next(1)

    def row_text(self, row: Row) -> str:
        if row.kind == "commit":
            return row.text
        f = self.files[row.file]
        match row.kind:
            case "file":
                return f.label
            case "hunk":
                return f.hunks[row.hunk].header
            case "line":
                return f.hunks[row.hunk].lines[row.line].text
            case "meta":
                return row.text
        return ""

    def search_next(self, step: int) -> None:
        if not self.search:
            self.flash("no previous search", "state.error")
            return
        pattern, direction = self.search
        step *= direction
        count = len(self.rows)
        for off in range(1, count + 1):
            i = (self.cur + off * step) % count
            if pattern.search(self.row_text(self.rows[i])):
                wrapped = (i < self.cur) if step > 0 else (i > self.cur)
                self.set_cur(i, "jump")
                if wrapped:
                    self.flash("search wrapped around", "state.warning")
                return
        self.flash(f"pattern not found: {pattern.pattern}", "state.error")

    def edit(self) -> None:
        row = self.rows[self.cur]
        if row.file < 0:
            self.flash("not on a file", "state.error")
            return
        f = self.files[row.file]
        if f.new_path is None:
            self.flash("that file is gone", "state.error")
            return
        candidates = [Path(f.new_path)]
        if self.root is not None:
            candidates.insert(0, self.root / f.new_path)
        path = next((p for p in candidates if p.exists()), None)
        if path is None:
            self.flash(f"can't find {f.new_path}", "state.error")
            return
        editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
        self.term.suspend()
        try:
            subprocess.run(
                [*shlex.split(editor), f"+{self.anchor(row)}", str(path)],
                stdin=self.term.fd,
                stdout=self.term.fd,
                stderr=self.term.fd,
            )
        finally:
            self.term.resume()
        if self.git_args is not None:
            self.reload()

    # drawing

    def diff_width(self) -> int:
        if self.tree_visible:
            return self.width - self.tree_width() - 1
        return self.width

    def widest_line(self) -> int:
        return max(
            (
                len(line.text.expandtabs(TAB))
                for f in self.files
                for h in f.hunks
                for line in h.lines
            ),
            default=0,
        )

    def draw(self) -> None:
        self.width, self.height = self.term.size()
        self.rewrap(self.diff_width())
        self.follow()
        if self.focus == "tree" and not self.tree_visible:
            self.focus = "diff"
        out = ["\x1b[?2026h"]
        tree_w = self.tree_width() if self.tree_visible else 0
        diff_w = self.diff_width()
        tree_lines = self.draw_tree(tree_w) if tree_w else []
        diff_lines = (
            self.draw_help(diff_w)
            if self.show_help
            else self.draw_diff(diff_w)
        )
        sep = sgr(Style(fg=role("text.faint"))) + "│\x1b[0m"
        for y in range(self.body_h):
            out.append(f"\x1b[{y + 1};1H")
            if tree_w:
                out.append(tree_lines[y] + sep)
            out.append(diff_lines[y])
        out.append(f"\x1b[{self.height};1H")
        out.append(self.draw_status())
        out.append("\x1b[?2026l")
        self.term.write("".join(out))

    def draw_tree(self, width: int) -> list[str]:
        rows = self.tree_rows()
        h = self.body_h - 1
        self.tree_cur = self.clamp(self.tree_cur, 0, len(rows) - 1)
        if self.tree_cur < self.tree_top:
            self.tree_top = self.tree_cur
        if self.tree_cur >= self.tree_top + h:
            self.tree_top = self.tree_cur - h + 1
        self.tree_top = self.clamp(self.tree_top, 0, max(0, len(rows) - h))

        added = sum(f.added for f in self.files)
        deleted = sum(f.deleted for f in self.files)
        title = LineBuf(width)
        noun = "file" if len(self.files) == 1 else "files"
        title.add(f" {len(self.files)} {noun} ", Style(bold=True))
        title.add(f"+{added} ", Style(fg=role("diff.add.accent")))
        title.add(f"-{deleted}", Style(fg=role("diff.del.accent")))
        title.fill(PLAIN)
        lines = [title.render()]

        current = self.current_page()
        status_colors = {
            "A": "state.success",
            "D": "state.error",
            "M": "accent.info",
            "R": "accent.link",
            "C": "accent.link",
        }
        for i in range(self.tree_top, self.tree_top + h):
            buf = LineBuf(width)
            if i >= len(rows):
                lines.append(buf.render() + " " * width)
                continue
            depth, node = rows[i]
            bg = None
            if i == self.tree_cur and self.focus == "tree":
                bg = role("surface.overlay")
            elif self.node_page(node) == current:
                bg = role("surface.raised")
            base = Style(bg=bg)
            buf.add(" ", base)
            guide = base._replace(fg=role("text.faint"))
            buf.add(tree_guides(node, depth), guide)
            if node.is_dir:
                arrow = "▾ " if node.expanded else "▸ "
                color = "state.warning" if node.commit else "file.dir"
                style = Style(fg=role(color), bg=bg, bold=True)
                buf.add(arrow, style)
                name = node.name if node.commit else node.name + "/"
                buf.add_clipped(name, style, width - buf.col)
            elif node.message is not None:
                style = Style(fg=role("state.warning"), bg=bg, bold=True)
                buf.add("≡ ", style)
                name_style = Style(bg=bg, bold=self.node_page(node) == current)
                buf.add_clipped(node.name, name_style, width - buf.col)
            else:
                f = self.files[node.file]
                buf.add(
                    f.status + " ",
                    Style(
                        fg=role(status_colors.get(f.status, "text.muted")),
                        bg=bg,
                        bold=True,
                    ),
                )
                counts = f" +{f.added} -{f.deleted}" if not f.binary else ""
                room = width - buf.col
                name_style = Style(bg=bg, bold=self.node_page(node) == current)
                if len(node.name) + len(counts) + 1 <= room:
                    buf.add(node.name, name_style)
                    buf.fill(base, width - len(counts) - 1)
                    buf.add(counts, Style(fg=role("text.faint"), bg=bg))
                else:
                    buf.add_clipped(node.name, name_style, room)
            buf.fill(base)
            lines.append(buf.render())
        return lines

    def draw_help(self, width: int) -> list[str]:
        lines = []
        for text in [""] + HELP.splitlines() + ["", "  any key to close"]:
            buf = LineBuf(width)
            style = (
                Style(bold=True)
                if text and not text.startswith(" ")
                else PLAIN
            )
            buf.add("  " + text, style)
            buf.fill(PLAIN)
            lines.append(buf.render())
        blank = LineBuf(width)
        blank.fill(PLAIN)
        return (lines + [blank.render()] * self.body_h)[: self.body_h]

    def draw_diff(self, width: int) -> list[str]:
        lines = []
        commit = self.pinned_commit()
        if commit is not None:
            bg = role("surface.raised")
            buf = LineBuf(width)
            self.draw_commit_head(buf, commit, Style(bg=bg), commit.subject)
            buf.fill(Style(bg=bg))
            lines.append(buf.render())
        hi = self.span[1]
        for i in range(self.top, self.top + self.view_h):
            buf = LineBuf(width)
            if i <= hi:
                self.draw_row(buf, self.rows[i], i == self.cur)
            buf.fill(PLAIN)
            lines.append(buf.render())
        return lines

    def draw_commit_head(
        self, buf: LineBuf, commit: Commit, base: Style, subject: str = ""
    ) -> None:
        """sha, author and date on one line, the subject after them if any."""
        muted = base._replace(fg=role("text.muted"))
        buf.add("  ", base)
        buf.add(
            commit.sha[:7], base._replace(fg=role("state.warning"), bold=True)
        )
        for part, style in (
            (commit.author, base),
            (relative_date(commit.date), muted),
        ):
            if part:
                buf.add(" · ", muted)
                buf.add(part, style)
        if commit.refs:
            buf.add(
                "  (" + commit.refs + ")",
                base._replace(fg=role("accent.link")),
            )
        if subject:
            buf.add(" · ", muted)
            buf.add_clipped(
                subject, base._replace(bold=True), buf.width - buf.col
            )

    def draw_row(self, buf: LineBuf, row: Row, is_cur: bool) -> None:
        f = self.files[row.file] if row.file >= 0 else None
        primary = (
            role("accent.primary")
            if self.focus == "diff"
            else role("text.faint")
        )
        sign = Style(fg=primary)

        def sign_col(bg: Color = None) -> None:
            buf.add("▌" if is_cur else " ", sign._replace(bg=bg))

        match row.kind:
            case "file":
                bg, fg = role("diff.meta.bg"), role("diff.meta.fg")
                sign_col(bg)
                base = Style(fg=fg, bg=bg, bold=True)
                status = {
                    "A": "added",
                    "D": "deleted",
                    "R": "renamed",
                    "C": "copied",
                }
                buf.add(" ", base)
                buf.add(f.label, base)
                if f.path in self.folded:
                    buf.add("  (folded)", base._replace(bold=False))
                buf.add("  ", base)
                if f.status in status:
                    buf.add(status[f.status] + "  ", base._replace(bold=False))
                buf.add(
                    f"+{f.added}", base._replace(fg=role("diff.add.accent"))
                )
                buf.add(" ", base)
                buf.add(
                    f"-{f.deleted}", base._replace(fg=role("diff.del.accent"))
                )
                buf.fill(base)
            case "meta":
                sign_col()
                buf.add(
                    " " * (self.num_width * 2 + 3) + row.text,
                    Style(fg=role("text.muted")),
                )
            case "commit":
                sign_col()
                if row.tone == "head":
                    commit = self.commits[row.hunk]
                    self.draw_commit_head(buf, commit, PLAIN)
                    return
                style = {
                    "subject": Style(bold=True),
                    "dim": Style(fg=role("text.muted")),
                }.get(row.tone, PLAIN)
                buf.add("  " + row.text, style)
            case "hunk":
                bg = role("diff.frag.bg")
                sign_col(bg)
                base = Style(fg=role("diff.frag.fg"), bg=bg)
                buf.add(" " + f.hunks[row.hunk].header, base)
                buf.fill(base)
            case "line":
                self.draw_code(buf, row, is_cur, sign_col)

    def draw_code(
        self, buf: LineBuf, row: Row, is_cur: bool, sign_col
    ) -> None:
        f = self.files[row.file]
        line = f.hunks[row.hunk].lines[row.line]
        bg = {
            "+": role("diff.add.bg"),
            "-": role("diff.del.bg"),
        }.get(line.kind)
        if bg is None and is_cur:
            bg = role("surface.raised")
        sign_col(bg)

        w = self.num_width
        gutter = Style(fg=role("text.faint"), bg=bg)
        if is_cur:
            gutter = Style(fg=role("accent.primary"), bg=bg, bold=True)
        old = "" if line.old is None else str(line.old)
        new = "" if line.new is None else str(line.new)
        buf.add(f"{old:>{w}} {new:>{w}} ", gutter)
        marker_color = {"+": "diff.add.accent", "-": "diff.del.accent"}.get(
            line.kind
        )
        marker = line.kind if line.kind in "+-" else " "
        buf.add(
            marker + " ",
            Style(
                fg=role(marker_color) if marker_color else None,
                bg=bg,
                bold=True,
            ),
        )

        base = Style(bg=bg)
        if line.kind == "\\":
            base = base._replace(fg=role("text.faint"))
        chars = [base] * len(line.text)

        hl = self.highlight(row.file)
        pos = 0
        for ttype, value in hl.tokens.get((row.hunk, row.line), []):
            color = token_color(ttype)
            if color is not None:
                for k in range(pos, min(pos + len(value), len(chars))):
                    chars[k] = chars[k]._replace(fg=color)
            pos += len(value)
        emph_bg = role(
            "diff.add.emph" if line.kind == "+" else "diff.del.emph"
        )
        for start, end in hl.emph.get((row.hunk, row.line), []):
            for k in range(start, min(end, len(chars))):
                chars[k] = chars[k]._replace(bg=emph_bg)
        if self.search:
            match_style = Style(
                fg=role("text.inverse"), bg=role("state.warning")
            )
            for m in self.search[0].finditer(line.text):
                for k in range(m.start(), m.end()):
                    chars[k] = match_style

        cells = expand(list(zip(line.text, chars)))
        col = 0
        for ch, cw, st in cells:
            if col < self.hscroll:
                if col + cw > self.hscroll:
                    for _ in range(col + cw - self.hscroll):
                        buf.put(" ", 1, st)
                col += cw
                continue
            if not buf.put(ch, cw, st):
                break
            col += cw
        buf.fill(base)

    def draw_status(self) -> str:
        bg = role("surface.overlay")
        base = Style(bg=bg)
        buf = LineBuf(self.width)
        if self.prompt is not None:
            kind, text = self.prompt
            buf.add(f"{kind}{text}", base)
            buf.add("▏", base._replace(fg=role("accent.primary")))
            buf.fill(base)
            return buf.render()

        mode = " TREE " if self.focus == "tree" else " DIFF "
        buf.add(mode, Style(fg=role("accent.primary"), bold=True, rev=True))
        buf.add(" ", base)
        row = self.rows[self.cur]
        lo, hi = self.span
        pct = 100 * (self.cur - lo) // max(1, hi - lo)
        text, style = self.message
        if row.kind == "commit":
            commit = self.commits[row.hunk]
            where = f"commit {row.hunk + 1}/{len(self.commits)}"
            if not text and row.tone == "head":
                text = " ".join([commit.sha, commit.author, commit.date])
            text = text or commit.title
        else:
            fi = row.file
            hunks = [r for r in self.rows if r.kind == "hunk" and r.file == fi]
            hunk_no = row.hunk + 1 if row.kind in ("hunk", "line") else 0
            where = (
                f"hunk {hunk_no}/{len(hunks)}"
                f"  file {fi + 1}/{len(self.files)}"
            )
            text = text or self.files[fi].label
        if not self.message[0]:
            style = PLAIN
        if self.unified != self.base_context:
            where = f"{'full' if self.full else f'U{self.context}'}  {where}"
        right = f" {self.count or self.pending}  {where}  {pct}% "
        room = self.width - buf.col - len(right)
        buf.add_clipped(text, style._replace(bg=bg), max(1, room))
        buf.fill(base, self.width - len(right))
        buf.add(right, base._replace(fg=role("text.faint")))
        buf.fill(base)
        return buf.render()

    def run(self) -> None:
        with Terminal() as self.term:
            self.flash(":h for help", "text.faint")
            while True:
                self.draw()
                key = self.term.read_key()
                if key is None:
                    continue
                try:
                    self.handle(key)
                except Quit:
                    return


def initial_context(git_args: list[str] | None) -> int:
    """The -U the diff was made with, as far as we can tell."""
    args = git_args or []
    if "--" in args:
        args = args[: args.index("--")]
    for arg in reversed(args):
        if m := re.fullmatch(r"(?:-U|--unified=)(\d+)", arg):
            return int(m[1])
    proc = subprocess.run(
        ["git", "config", "--get", "diff.context"],
        capture_output=True,
        text=True,
    )
    return int(proc.stdout) if proc.stdout.strip().isdigit() else 3


def git_root() -> Path | None:
    proc = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
    )
    return Path(proc.stdout.strip()) if proc.returncode == 0 else None


def run_git_diff(args: list[str]) -> str:
    proc = subprocess.run(
        [
            "git",
            "-c",
            "core.quotePath=false",
            "diff",
            "--no-color",
            "--no-ext-diff",
            "--src-prefix=a/",
            "--dst-prefix=b/",
            *args,
        ],
        capture_output=True,
    )
    if proc.returncode not in (0, 1):
        sys.stderr.write(proc.stderr.decode(errors="replace"))
        raise SystemExit(proc.returncode)
    return proc.stdout.decode(errors="replace")


def main() -> None:
    if sys.stdin.isatty():
        git_args: list[str] | None = sys.argv[1:]
        text = run_git_diff(git_args)
    else:
        # As git's pager this gets colored output, and sometimes no diff at
        # all (--stat, --name-only), which goes on to a plain pager instead.
        git_args = None
        raw = sys.stdin.buffer.read()
        text = ANSI_RE.sub("", raw.decode(errors="replace"))

    if not sys.stdout.isatty():
        sys.stdout.write(text)
        return

    app = App(git_args, text)
    if not app.files:
        if git_args is None:
            subprocess.run(["less", "-FRX"], input=raw)
        else:
            print("no changes")
        return
    app.run()


if __name__ == "__main__":
    main()
