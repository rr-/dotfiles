#!/bin/sh
# Usage: rsync-move [-n] SOURCE DEST
#
# Move the contents of the directory SOURCE into DEST (either may be
# host:path) with rsync, showing the progress of the whole transfer.
# A failed or interrupted rsync is retried, waiting longer each time, and
# resumes where it stopped; each source file is removed only once it has
# arrived. When nothing is left to move, the empty directories under
# SOURCE are removed. Run it again at any time to continue.
#
# -n: show what would be moved and change nothing.
# RSYNC_RSH: the ssh command to use, e.g. with -i for another key.

set -u

dry_run=""
if [ "${1:-}" = "-n" ]; then
    dry_run="--dry-run"
    shift
fi
if [ $# -ne 2 ]; then
    sed -n '2,13s/^# \{0,1\}//p' "$0" >&2
    exit 2
fi
source=${1%/}/
dest=${2%/}/

case $source in
    *:*) remote_source=1 ;;
    *) remote_source="" ;;
esac
if [ -z "$remote_source" ] && [ ! -d "$source" ]; then
    echo "rsync-move: $source is not a directory" >&2
    exit 2
fi

wait_seconds=10
attempt=1
while :; do
    echo "rsync-move: attempt $attempt: $source -> $dest" >&2
    rsync --archive --partial --partial-dir=.rsync-partial \
        --remove-source-files --no-inc-recursive --info=progress2 \
        --human-readable --timeout=300 \
        -e "${RSYNC_RSH:-ssh} -o ServerAliveInterval=15 -o ServerAliveCountMax=4" \
        $dry_run "$source" "$dest"
    status=$?
    case $status in
        0|24) break ;;
        1|2|4) echo "rsync-move: rsync failed ($status); not retrying" >&2
            exit "$status" ;;
    esac
    echo "rsync-move: rsync failed ($status); retrying in ${wait_seconds}s" >&2
    sleep "$wait_seconds"
    wait_seconds=$((wait_seconds * 2))
    [ "$wait_seconds" -gt 300 ] && wait_seconds=300
    attempt=$((attempt + 1))
done

if [ -n "$dry_run" ]; then
    exit 0
fi
if [ -n "$remote_source" ]; then
    echo "rsync-move: moved; the empty directories on ${source%%:*} stay" >&2
    exit 0
fi

left=$(find "$source" -type f ! -path '*/.rsync-partial/*' | wc -l)
if [ "$left" -gt 0 ]; then
    echo "rsync-move: $left file(s) appeared in $source meanwhile; run me again" >&2
    exit 1
fi
find "$source" -mindepth 1 -depth -type d -empty -delete
echo "rsync-move: done; $source is empty" >&2
