#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["wordfreq"]
# ///
"""A terminal Wordle clone.

Words come from the `wordfreq` corpus by default, or from a dictionary file
given as an argument. Answers are drawn from the words common enough to be
worth guessing; any word of the right length is still accepted as a guess.
"""

import argparse
import random
import sys
from collections import Counter

GREEN = "\033[42;30m"
YELLOW = "\033[43;30m"
GREY = "\033[100;97m"
RESET = "\033[0m"


def load_words(path: str, length: int) -> list[str]:
    words: set[str] = set()
    with open(path, encoding="utf-8", errors="replace") as handle:
        for line in handle:
            word = line.strip().lower()
            if len(word) == length and word.isalpha() and word.isascii():
                words.add(word)
    return sorted(words)


def corpus_words(length: int, lang: str, size: int) -> list[str]:
    """The corpus's own vocabulary, for when no dictionary file is given."""
    from wordfreq import top_n_list

    return sorted(
        w
        for w in top_n_list(lang, size)
        if len(w) == length and w.isalpha() and w.isascii()
    )


def answer_pool(words: list[str], lang: str, min_zipf: float) -> list[str]:
    """The words common enough to be fair answers.

    A raw corpus slice is mostly filler no one would guess, so answers are
    restricted by frequency while guesses are not.
    """
    from wordfreq import zipf_frequency

    return [w for w in words if zipf_frequency(w, lang) >= min_zipf]


def score(guess: str, answer: str) -> list[str]:
    """Return a list of 'green', 'yellow' or 'grey' per letter."""
    result = ["grey"] * len(guess)
    leftover: Counter[str] = Counter()
    for i, (g, a) in enumerate(zip(guess, answer)):
        if g == a:
            result[i] = "green"
        else:
            leftover[a] += 1
    for i, g in enumerate(guess):
        if result[i] == "green":
            continue
        if leftover[g] > 0:
            result[i] = "yellow"
            leftover[g] -= 1
    return result


def render(guess: str, marks: list[str], color: bool) -> str:
    if not color:
        symbols = {"green": "*", "yellow": "?", "grey": "."}
        return (
            " ".join(g.upper() for g in guess)
            + "  "
            + "".join(symbols[m] for m in marks)
        )
    styles = {"green": GREEN, "yellow": YELLOW, "grey": GREY}
    return "".join(
        f"{styles[m]} {g.upper()} {RESET}" for g, m in zip(guess, marks)
    )


def play(words: list[str], answer: str, tries: int, color: bool) -> bool:
    valid = set(words)
    used: list[str] = []
    for attempt in range(1, tries + 1):
        try:
            guess = input(f"Guess {attempt}/{tries}: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print(f"\nBailing. The word was {answer.upper()}.")
            return False
        if len(guess) != len(answer):
            print(f"Needs to be {len(answer)} letters.")
            continue
        if guess not in valid:
            print("Not a word I know.")
            continue
        marks = score(guess, answer)
        used.append(render(guess, marks, color))
        print("\n".join(used))
        if guess == answer:
            print(f"Got it in {len(used)}.")
            return True
    print(f"Out of guesses. The word was {answer.upper()}.")
    return False


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Play Wordle in the terminal."
    )
    parser.add_argument(
        "dictionary",
        nargs="?",
        help="file with one word per line; omit to use the corpus vocabulary",
    )
    parser.add_argument(
        "-l", "--length", type=int, default=5, help="word length (default 5)"
    )
    parser.add_argument(
        "-t",
        "--tries",
        type=int,
        default=6,
        help="number of guesses (default 6)",
    )
    parser.add_argument(
        "-s",
        "--seed",
        type=int,
        help="seed the answer pick for a reproducible game",
    )
    parser.add_argument(
        "-a", "--answer", help="force a specific answer instead of picking one"
    )
    parser.add_argument(
        "--corpus-size",
        type=int,
        default=200_000,
        help="corpus words considered when no dictionary is given "
        "(default 200000)",
    )
    parser.add_argument(
        "--lang",
        default="en",
        help="wordfreq language for the vocabulary (default en)",
    )
    parser.add_argument(
        "--answer-zipf",
        type=float,
        default=3.5,
        help="how common an answer must be, in zipf units; 0 allows any word "
        "of the right length (default 3.5)",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="use *?. instead of colored blocks",
    )
    args = parser.parse_args(argv)

    if args.length < 1:
        parser.error("length must be positive")
    if args.tries < 1:
        parser.error("tries must be positive")

    if args.dictionary:
        try:
            words = load_words(args.dictionary, args.length)
        except OSError as exc:
            parser.error(f"cannot read {args.dictionary}: {exc}")
        source = args.dictionary
    else:
        if args.corpus_size < 1:
            parser.error("--corpus-size must be positive")
        words = corpus_words(args.length, args.lang, args.corpus_size)
        source = f"the top {args.corpus_size} {args.lang} words"

    if not words:
        parser.error(f"no {args.length}-letter words found in {source}")

    answers = words
    if args.answer_zipf > 0:
        answers = answer_pool(words, args.lang, args.answer_zipf) or words

    if args.answer:
        answer = args.answer.strip().lower()
        if len(answer) != args.length:
            parser.error(f"answer must be {args.length} letters")
    else:
        rng = random.Random(args.seed)
        answer = rng.choice(answers)

    color = not args.no_color and sys.stdout.isatty()
    print(
        f"{len(words)} words from {source}, "
        f"{len(answers)} of them possible answers. "
        f"{args.length} letters, {args.tries} guesses."
    )
    return 0 if play(words, answer, args.tries, color) else 1


if __name__ == "__main__":
    sys.exit(main())
